---
import BaseLayout from '../layouts/BaseLayout.astro';
import store from '../data/store.json';
const all = store.products.map(p => ({ ...p, off: Math.round((1 - p.price / p.oldPrice) * 100) }));
const hot = all.filter(p => p.tag === 'HOT SALE');
const trending = all.filter(p => p.tag === 'TRENDING');
const fresh = all.filter(p => p.tag === 'NEW DEAL');
const shelves = [
  { icon: '🔥', title: 'Hot Sale', items: hot },
  { icon: '📈', title: 'Trending Now', items: trending },
  { icon: '✨', title: 'New Deals', items: fresh },
];
---
<BaseLayout title="IRFAN-GD Store — AliExpress Gadget Picks & Deals" description="IRFAN-GD Store: trending gadgets, new deals and hot-sale AliExpress picks with direct Shop Now links. Only trending, new-deal and hot-sale products — refreshed from daily research.">
  <style>
    .sf-hero { background: radial-gradient(1100px 480px at 15% -10%, rgba(245,179,1,.28), transparent 60%), radial-gradient(900px 500px at 95% 0%, rgba(20,184,166,.25), transparent 55%), linear-gradient(135deg, #0b1226, #12203a 55%, #0d2b2e); border: 1px solid rgba(255,255,255,.08); }
    .sf-marquee { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
    .sf-track { display: flex; gap: 1rem; width: max-content; will-change: transform; animation: sf-scroll 18s linear infinite; }
    .sf-marquee:hover .sf-track { animation-play-state: paused; }
    @keyframes sf-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    @keyframes sf-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.06); } }
    .sf-live { animation: sf-pulse 1.6s ease-in-out infinite; }
    @keyframes sf-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
    .sf-float { animation: sf-float 5s ease-in-out infinite; }
  </style>
  <div class="mx-auto" style="max-width:1200px;padding:1.2rem 1rem 0">
    <!-- Storefront hero -->
    <header class="sf-hero" style="border-radius:26px;padding:0 0 1.6rem;position:relative;overflow:hidden">
      <img src="/store/banner.webp" alt="IRFAN-GD — Premium Electronics Accessories Store" width="1672" height="941" style="width:100%;height:auto;display:block" />
      <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap;padding:1.4rem 1.4rem 0">
        <img class="sf-float" src="/store/avatar.webp" alt="IRFAN-GD avatar logo" width="512" height="512" style="width:74px;height:74px;border-radius:50%;object-fit:cover;border:3px solid rgba(255,255,255,.35)" />
        <div style="min-width:240px;flex:1">
          <p style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <span style="font-size:1.9rem;font-weight:900;letter-spacing:.01em">IRFAN-GD</span>
            <span class="sf-live" style="background:#e11d48;color:#fff;font-weight:800;font-size:.72rem;padding:.28rem .6rem;border-radius:999px">● 11.11 SALE LIVE</span>
          </p>
          <p class="text-dim" style="margin-top:.2rem">Official gadget store — trending products, new deals &amp; hot sales only.</p>
        </div>
      </div>
      <p style="display:flex;gap:6px;flex-wrap:wrap;margin-top:1.1rem;padding:0 1.4rem">
        <span class="chip">🛍️ {all.length} curated picks</span>
        <span class="chip">🇺🇸 Ships to USA</span>
        <span class="chip">🔄 Refreshed from daily research</span>
        <span class="chip">Last updated {store.updated}</span>
      </p>
    </header>

    <!-- Animated HOT SALE showcase -->
    <section aria-label="Hot sale showcase" style="margin-top:1.6rem">
      <h2 style="font-weight:900;font-size:1.45rem;display:flex;align-items:center;gap:.5rem">🔥 Hot Sale Showcase <span class="text-faint" style="font-size:.8rem;font-weight:600">— auto-scrolling, hover to pause</span></h2>
      <div class="sf-marquee" style="margin-top:.8rem">
        <div class="sf-track">
          {[...hot, ...hot].map(p => (
            <a href={p.url} target="_blank" rel="sponsored nofollow noopener" class="glass" style="width:250px;flex:none;padding:12px;display:block;text-decoration:none">
              <span style="position:relative;display:block;border-radius:14px;overflow:hidden">
                <img src={p.img} alt={p.name} loading="lazy" width="640" height="640" style="width:100%;height:auto;display:block" />
                <span style="position:absolute;top:8px;left:8px;background:#e11d48;color:#fff;font-weight:800;font-size:.72rem;padding:.22rem .5rem;border-radius:999px">🔥 HOT SALE</span>
                <span style="position:absolute;bottom:8px;right:8px;background:#f5b301;color:#111;font-weight:800;font-size:.75rem;padding:.22rem .5rem;border-radius:999px">-{p.off}%</span>
              </span>
              <span style="display:block;font-weight:800;margin:.55rem 0 .15rem;font-size:.95rem;line-height:1.3">{p.name}</span>
              <span style="display:flex;align-items:baseline;gap:.45rem"><strong style="font-size:1.15rem">${p.price.toFixed(2)}</strong><span class="text-faint" style="text-decoration:line-through;font-size:.85rem">${p.oldPrice.toFixed(2)}</span><span class="text-dim" style="font-size:.8rem">★ {p.rating}</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <div class="glass" style="padding:14px 16px;margin:1.4rem 0 0" role="note">
      <strong>Disclosure:</strong> The Shop Now buttons are AliExpress affiliate links. If you buy through one, IRFAN-GD may earn a commission at no extra cost to you. Prices, ratings and sold counts are as listed on AliExpress at the last update; the price on the product page is the one that counts. Full details: <a href="/disclosure/" style="text-decoration:underline">Affiliate Disclosure</a>.
    </div>

    <!-- Shelves -->
    {shelves.map(s => (
      <section aria-label={s.title} style="margin-top:2rem">
        <h2 style="font-weight:900;font-size:1.45rem">{s.icon} {s.title}</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr));gap:1rem;margin-top:.9rem">
          {s.items.map(p => (
            <article class="glass" style="padding:16px;display:flex;flex-direction:column">
              <div style="position:relative;border-radius:16px;overflow:hidden">
                <img src={p.img} alt={p.name} loading="lazy" width="640" height="640" style="width:100%;height:auto;display:block" />
                <span style="position:absolute;top:10px;left:10px;background:#f5b301;color:#111;font-weight:800;font-size:.8rem;padding:.25rem .55rem;border-radius:999px">-{p.off}%</span>
                <span style="position:absolute;top:10px;right:10px;background:#111827;color:#fff;font-weight:800;font-size:.72rem;letter-spacing:.04em;padding:.25rem .55rem;border-radius:999px">{p.tag === 'HOT SALE' ? '🔥 ' : p.tag === 'NEW DEAL' ? '✨ ' : '📈 '}{p.tag}</span>
              </div>
              <h3 style="font-weight:800;margin:.7rem 0 .3rem;font-size:1.08rem">{p.name}</h3>
              <p class="text-dim" style="font-size:.92rem;line-height:1.55">{p.blurb}</p>
              <p style="margin-top:.55rem;display:flex;gap:6px;flex-wrap:wrap">
                <span class="chip">★ {p.rating} on AliExpress</span>
                {p.sold && <span class="chip">{p.sold}</span>}
              </p>
              <p style="margin-top:.7rem;display:flex;align-items:baseline;gap:.55rem">
                <span style="font-size:1.45rem;font-weight:900">${p.price.toFixed(2)}</span>
                <span class="text-faint" style="text-decoration:line-through">${p.oldPrice.toFixed(2)}</span>
              </p>
              <a href={p.url} target="_blank" rel="sponsored nofollow noopener" style="margin-top:.8rem;display:block;text-align:center;background:#f5b301;color:#111;font-weight:850;padding:.75rem 1rem;border-radius:14px">SHOP NOW →</a>
            </article>
          ))}
        </div>
      </section>
    ))}

    <p class="text-faint" style="font-size:.82rem;margin:1.6rem 0 .4rem">Prices and availability can change at any time on AliExpress. IRFAN-GD does not sell or ship these products; orders, payments, shipping and returns are handled by AliExpress and the individual sellers.</p>
    <p class="text-faint" style="font-size:.82rem;margin:0 0 2.5rem">As an affiliate, I may earn a commission from qualifying purchases.</p>
  </div>
</BaseLayout>
