  <script type="application/json" id="pdata" set:html={JSON.stringify(pdata)}></script>
  <script is:inline>
    (function(){
      var products = [];
      try { products = JSON.parse(document.getElementById('pdata').textContent || '[]'); } catch(e){}
      var visIdx = []; products.forEach(function(p, i){ if (p.vis !== false) visIdx.push(i); });
      function cardIdx(card){ return visIdx[+card.getAttribute('data-idx')]; }
      function gridPos(origIdx){ return visIdx.indexOf(origIdx); }
      var grid = document.getElementById('grid');
      var cards = grid ? Array.prototype.slice.call(grid.querySelectorAll('.pcard')) : [];
      var qEl = document.getElementById('q'), sortEl = document.getElementById('sort');
      var nores = document.getElementById('nores'), countLabel = document.getElementById('countLabel');
      var state = { q:'', cat:'all', sort:'featured' };
      function track(name, params){ try{ if (window.gtag) window.gtag('event', name, params || {}); }catch(e){} }
      function escTop(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;'); }
      function setCat(cat){
        state.cat = cat;
        document.querySelectorAll('.fchip').forEach(function(ch){ ch.classList.toggle('on', ch.getAttribute('data-cat') === cat); });
        apply();
      }
      function apply(){
        var q = state.q.trim().toLowerCase();
        var visible = cards.filter(function(card){
          var okCat = state.cat === 'all' || (card.getAttribute('data-cats') || '').split(' ').indexOf(state.cat) !== -1;
          var hay = (card.getAttribute('data-name') || '') + ' ' + (card.getAttribute('data-catlabels') || '') + ' ' + (card.getAttribute('data-kw') || '');
          return okCat && (!q || hay.indexOf(q) !== -1);
        });
        cards.forEach(function(c){ c.style.display = 'none'; });
        var sorted = visible.slice();
        if (state.sort === 'price-asc') sorted.sort(function(a,b){ return (+a.dataset.price) - (+b.dataset.price); });
        else if (state.sort === 'price-desc') sorted.sort(function(a,b){ return (+b.dataset.price) - (+a.dataset.price); });
        else if (state.sort === 'rating') sorted.sort(function(a,b){ return (+b.dataset.rating) - (+a.dataset.rating); });
        else if (state.sort === 'trending') sorted.sort(function(a,b){ return (b.dataset.tag === 'TRENDING' ? 1 : 0) - (a.dataset.tag === 'TRENDING' ? 1 : 0) || (+b.dataset.rating) - (+a.dataset.rating); });
        else if (state.sort === 'new') sorted.sort(function(a,b){ return (b.dataset.tag === 'NEW DEAL' ? 1 : 0) - (a.dataset.tag === 'NEW DEAL' ? 1 : 0); });
        else sorted.sort(function(a,b){ return (+a.dataset.idx) - (+b.dataset.idx); });
        sorted.forEach(function(c){ c.style.display = ''; grid.appendChild(c); });
        if (countLabel) countLabel.textContent = visible.length + ' product' + (visible.length === 1 ? '' : 's');
        if (nores) nores.classList.toggle('show', visible.length === 0);
      }
      if (qEl) { var deb; qEl.addEventListener('input', function(){ state.q = qEl.value; apply(); clearTimeout(deb); deb = setTimeout(function(){ if (state.q.trim()) track('store_search', { search_term: state.q.trim() }); }, 600); }); }
      if (sortEl) sortEl.addEventListener('change', function(){ state.sort = sortEl.value; apply(); });
      document.querySelectorAll('.fchip').forEach(function(ch){ var cat = ch.getAttribute('data-cat'); if (!cat) return; ch.addEventListener('click', function(){ setCat(cat); track('store_category', { category: state.cat }); }); });
      document.querySelectorAll('[data-cat-link]').forEach(function(el){ el.addEventListener('click', function(){ var c = el.getAttribute('data-cat-link'); setCat(c || 'all'); track('store_category', { category: c }); var s = document.getElementById('shop'); if (s) s.scrollIntoView({ behavior:'smooth' }); }); });
      var clearBtn = document.getElementById('clearFilters');
      if (clearBtn) clearBtn.addEventListener('click', function(){ state.q = ''; if (qEl) qEl.value = ''; state.sort = 'featured'; if (sortEl) sortEl.value = 'featured'; setCat('all'); });
      document.querySelectorAll('.shop-now-link').forEach(function(a){ a.addEventListener('click', function(){ track('affiliate_click', { product: a.getAttribute('data-product') || '' }); }); });
      /* Details modal */
      var dlg = document.getElementById('pdlg');
      function money(v){ return '$' + (+v).toFixed(2); }
      function openDetails(i){
        var p = products[i]; if (!p || !dlg) return;
        document.getElementById('pdImg').src = p.img; document.getElementById('pdImg').alt = p.name;
        document.getElementById('pdCat').textContent = p.catLabels;
        document.getElementById('pdName').textContent = p.name;
        document.getElementById('pdBlurb').textContent = p.blurb;
        document.getElementById('pdRating').textContent = '★ ' + p.rating + ' on AliExpress';
        document.getElementById('pdSold').textContent = p.sold || '';
        document.getElementById('pdSold').style.display = p.sold ? '' : 'none';
        document.getElementById('pdTag').textContent = p.tag;
        document.getElementById('pdPrice').textContent = money(p.price);
        document.getElementById('pdWas').textContent = money(p.oldPrice);
        var shop = document.getElementById('pdShop'); shop.href = p.url; shop.setAttribute('data-product', p.name);
        if (dlg.showModal) dlg.showModal(); else dlg.setAttribute('open','');
      }
      document.querySelectorAll('[data-details]').forEach(function(b){ b.addEventListener('click', function(){ openDetails(visIdx[+b.getAttribute('data-details')]); }); });
      var x = document.getElementById('pdlgClose');
      if (x && dlg) x.addEventListener('click', function(){ dlg.close(); });
      if (dlg) dlg.addEventListener('click', function(e){ if (e.target === dlg) dlg.close(); });

      /* ---------- image skeleton ---------- */
      document.querySelectorAll('.pimg img').forEach(function(img){
        function done(){ img.classList.add('ld'); var w = img.closest('.pimg'); if (w) w.classList.add('done'); }
        if (img.complete && img.naturalWidth) done(); else { img.addEventListener('load', done); img.addEventListener('error', done); }
      });

      /* ---------- SPOTLIGHT carousel ---------- */
      var vprods = products.filter(function(p){ return p.vis !== false; });
      var seen = {}; var featured = vprods.filter(function(p){ var take = (p.tag === 'HOT SALE') && !seen[p.name]; seen[p.name] = true; return take; });
      vprods.forEach(function(p){ if (p.name && featured.length < 4 && featured.indexOf(p) === -1 && (p.tag === 'TRENDING')) featured.push(p); });
      featured = featured.slice(0, 4);
      var stage = document.getElementById('spotStage'), dots = document.getElementById('spotDots'), cur = 0, timer = null;
      function esc(s){ return escTop(s); } function escUnused(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;'); }
      if (stage && featured.length){
        stage.innerHTML = featured.map(function(p, i){
          return '<div class="spot-slide' + (i === 0 ? ' on' : '') + '" role="group" aria-label="' + esc(p.name) + '">' +
            '<div class="spot-img"><img src="' + p.img + '" alt="' + esc(p.name) + '" width="640" height="640" ' + (i ? 'loading="lazy"' : '') + '><span class="badge b-off" style="top:12px;left:12px">-' + p.off + '% OFF</span></div>' +
            '<div><p class="pcat" style="margin-top:0">' + esc(p.catLabels) + '</p>' +
            '<h3 style="font-size:1.5rem;font-weight:900;margin:.2rem 0 .4rem;line-height:1.2">' + esc(p.name) + '</h3>' +
            '<p class="pblurb" style="font-size:.98rem">' + esc(p.blurb) + '</p>' +
            '<p class="pmeta"><span class="chip">★ ' + p.rating + ' on AliExpress</span>' + (p.sold ? '<span class="chip">' + esc(p.sold) + '</span>' : '') + '<span class="chip" style="color:var(--gold2);border-color:var(--line)">' + esc(p.tag) + '</span></p>' +
            '<p class="pprice"><span class="now" style="font-size:1.7rem">$' + (+p.price).toFixed(2) + '</span><span class="was">$' + (+p.oldPrice).toFixed(2) + '</span><span class="usd">USD</span></p>' +
            '<div class="pactions" style="max-width:420px"><a class="shop-now shop-now-link" data-product="' + esc(p.name) + '" href="' + p.url + '" target="_blank" rel="sponsored nofollow noopener">SHOP NOW →</a>' +
            '<button type="button" class="details" data-spot-details="' + products.indexOf(p) + '">DETAILS</button></div></div></div>';
        }).join('');
        dots.innerHTML = featured.map(function(p, i){ return '<button type="button" data-dot="' + i + '" aria-label="Show ' + esc(p.name) + '"' + (i === 0 ? ' class="on"' : '') + '></button>'; }).join('');
        var slides = Array.prototype.slice.call(stage.querySelectorAll('.spot-slide'));
        function show(i){
          cur = (i + slides.length) % slides.length;
          slides.forEach(function(s, j){ s.classList.toggle('on', j === cur); });
          dots.querySelectorAll('button').forEach(function(d, j){ d.classList.toggle('on', j === cur); });
        }
        function auto(){ clearInterval(timer); timer = setInterval(function(){ show(cur + 1); }, 6000); }
        document.getElementById('spotPrev').addEventListener('click', function(){ show(cur - 1); auto(); });
        document.getElementById('spotNext').addEventListener('click', function(){ show(cur + 1); auto(); });
        dots.querySelectorAll('button').forEach(function(d){ d.addEventListener('click', function(){ show(+d.getAttribute('data-dot')); auto(); }); });
        var spot = document.getElementById('spot');
        spot.addEventListener('pointerenter', function(){ clearInterval(timer); });
        spot.addEventListener('pointerleave', auto);
        var sx = null;
        spot.addEventListener('touchstart', function(e){ sx = e.touches[0].clientX; }, { passive: true });
        spot.addEventListener('touchend', function(e){ if (sx === null) return; var dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 42) show(cur + (dx < 0 ? 1 : -1)); sx = null; auto(); }, { passive: true });
        stage.querySelectorAll('.spot-img img').forEach(function(img){
          img.addEventListener('pointermove', function(e){ var r = img.getBoundingClientRect(); var rx = ((e.clientY - r.top) / r.height - .5) * -7; var ry = ((e.clientX - r.left) / r.width - .5) * 9; img.style.transform = 'rotateX(' + rx + 'deg) rotateY(' + ry + 'deg) scale(1.03)'; });
          img.addEventListener('pointerleave', function(){ img.style.transform = ''; });
        });
        stage.querySelectorAll('[data-spot-details]').forEach(function(b){ b.addEventListener('click', function(){ openDetails(+b.getAttribute('data-spot-details')); }); });
        stage.querySelectorAll('.shop-now-link').forEach(function(a){ a.addEventListener('click', function(){ track('affiliate_click', { product: a.getAttribute('data-product') || '' }); }); });
        auto();
      }

      /* ---------- CIRCULAR MOVING SHOWCASE ---------- */
      (function(){
        var track = document.getElementById('orbitTrack'); if (!track) return;
        var items = '';
        products.forEach(function(p, i){
          if (p.vis === false) return;
          items += '<button type="button" class="orbit-item" data-orbit="' + i + '" aria-label="' + esc(p.name) + '">'
            + '<span class="orbit-ring"><img src="' + p.img + '" alt="' + esc(p.name) + '" loading="lazy"></span>'
            + '<span class="orbit-name">' + esc(p.name) + '</span>'
            + '<span class="orbit-price">$' + (+p.price).toFixed(2) + '</span></button>';
        });
        track.innerHTML = items + items;
        // animation sirf tab jab poora set track mein aa jaye (warna pehla paint dev tools mein bada render hota hai)
        requestAnimationFrame(function(){ requestAnimationFrame(function(){ track.classList.add('go'); }); });
        track.addEventListener('click', function(e){
          var b = e.target.closest('.orbit-item'); if (!b) return;
          openDetails(+b.getAttribute('data-orbit'));
        });
      })();

      /* ---------- SEARCH SUGGESTIONS ---------- */
      var sug = document.getElementById('suggest');
      function renderSuggest(){
        var q = (qEl.value || '').trim().toLowerCase();
        if (!q || !sug) { if (sug) sug.classList.remove('show'); return; }
        var hits = products.filter(function(p){ return p.vis !== false && (p.name + ' ' + p.catLabels + ' ' + (p.cats || []).join(' ')).toLowerCase().indexOf(q) !== -1; }).slice(0, 5);
        if (!hits.length) { sug.classList.remove('show'); return; }
        sug.innerHTML = hits.map(function(p){
          return '<button type="button" role="option" data-sug="' + products.indexOf(p) + '"><img src="' + p.img + '" alt="" width="38" height="38"><span style="flex:1">' + esc(p.name) + '</span><strong>$' + (+p.price).toFixed(2) + '</strong></button>';
        }).join('');
        sug.classList.add('show');
        sug.querySelectorAll('[data-sug]').forEach(function(b){ b.addEventListener('click', function(){ sug.classList.remove('show'); openDetails(+b.getAttribute('data-sug')); }); });
      }
      if (qEl) { qEl.addEventListener('input', renderSuggest); qEl.addEventListener('focus', renderSuggest); document.addEventListener('click', function(e){ if (sug && !sug.contains(e.target) && e.target !== qEl) sug.classList.remove('show'); }); }

      /* ---------- VOICE SEARCH (browser permitting) ---------- */
      var mic = document.getElementById('micBtn');
      var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (mic && SR) {
        mic.hidden = false;
        mic.addEventListener('click', function(){
          try {
            var rec = new SR(); rec.lang = 'en-US'; rec.interimResults = false;
            mic.textContent = '🔴';
            rec.onresult = function(ev){ var t = ev.results[0][0].transcript || ''; qEl.value = t; state.q = t; apply(); renderSuggest(); mic.textContent = '🎤'; };
            rec.onend = function(){ mic.textContent = '🎤'; };
            rec.onerror = function(){ mic.textContent = '🎤'; };
            rec.start();
          } catch(e){ mic.hidden = true; }
        });
      }

      /* ---------- PRICE FILTER ---------- */
      var priceEl = document.getElementById('maxPrice'), priceLabel = document.getElementById('maxPriceLabel');
      state.maxPrice = 25;
      var baseApply = apply;
      apply = function(){
        cards.forEach(function(c){ /* price gate handled below via dataset */ });
        baseApply();
        var mp = state.maxPrice;
        var shown = 0;
        cards.forEach(function(c){
          if (c.style.display !== 'none' && (+c.dataset.price) > mp) c.style.display = 'none';
          if (c.style.display !== 'none') shown++;
        });
        if (countLabel) countLabel.textContent = shown + ' product' + (shown === 1 ? '' : 's');
        if (nores) nores.classList.toggle('show', shown === 0);
      };
      if (priceEl) priceEl.addEventListener('input', function(){ state.maxPrice = +priceEl.value; if (priceLabel) priceLabel.textContent = 'Up to $' + state.maxPrice; apply(); });

      /* ---------- WISHLIST ---------- */
      var wish = new Set();
      try { (JSON.parse(localStorage.getItem('irfan-wishlist') || '[]')).forEach(function(i){ wish.add(i); }); } catch(e){}
      state.wishOnly = false;
      var wishChip = document.getElementById('wishChip'), wishCount = document.getElementById('wishCount');
      function saveWish(){ try { localStorage.setItem('irfan-wishlist', JSON.stringify(Array.from(wish))); } catch(e){} }
      function paintWish(){
        document.querySelectorAll('[data-wish]').forEach(function(b){ var i = visIdx[+b.getAttribute('data-wish')]; var on = wish.has(i); b.classList.toggle('on', on); b.textContent = on ? '♥' : '♡'; b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
        if (wishCount) wishCount.textContent = wish.size;
      }
      document.querySelectorAll('[data-wish]').forEach(function(b){
        b.addEventListener('click', function(){
          var i = visIdx[+b.getAttribute('data-wish')];
          if (wish.has(i)) wish.delete(i); else { wish.add(i); track('wishlist_add', { product: products[i] ? products[i].name : '' }); }
          saveWish(); paintWish(); if (state.wishOnly) applyWish();
        });
      });
      function applyWish(){
        if (!state.wishOnly) { applyOrig(); return; }
        applyOrig();
        var shown = 0;
        cards.forEach(function(c){ if (c.style.display !== 'none' && !wish.has(cardIdx(c))) c.style.display = 'none'; if (c.style.display !== 'none') shown++; });
        if (countLabel) countLabel.textContent = shown + ' product' + (shown === 1 ? '' : 's');
        if (nores) nores.classList.toggle('show', shown === 0);
      }
      var applyOrig = apply;
      apply = function(){ if (state.wishOnly) applyWish(); else applyOrig(); };
      if (wishChip) wishChip.addEventListener('click', function(){ state.wishOnly = !state.wishOnly; wishChip.classList.toggle('on', state.wishOnly); wishChip.setAttribute('aria-pressed', state.wishOnly ? 'true' : 'false'); apply(); });
      paintWish();

      /* ---------- COMPARE (up to 4) ---------- */
      var cmp = [];
      var tray = document.getElementById('cmpTray'), cmpLabel = document.getElementById('cmpLabel');
      function paintCmp(){
        if (cmpLabel) cmpLabel.textContent = 'Compare: ' + cmp.length + ' selected';
        if (tray) tray.classList.toggle('show', cmp.length > 0);
        document.querySelectorAll('[data-compare]').forEach(function(cb){ cb.checked = cmp.indexOf(visIdx[+cb.getAttribute('data-compare')]) !== -1; });
      }
      document.querySelectorAll('[data-compare]').forEach(function(cb){
        cb.addEventListener('change', function(){
          var i = visIdx[+cb.getAttribute('data-compare')];
          if (cb.checked) { if (cmp.length >= 4) { cb.checked = false; if (cmpLabel) cmpLabel.textContent = 'Compare: max 4 products'; return; } cmp.push(i); }
          else cmp = cmp.filter(function(x){ return x !== i; });
          paintCmp();
        });
      });
      var cmpDlg = document.getElementById('cmpDlg');
      document.getElementById('cmpClear').addEventListener('click', function(){ cmp = []; paintCmp(); });
      document.getElementById('cmpClose').addEventListener('click', function(){ cmpDlg.close(); });
      document.getElementById('cmpOpen').addEventListener('click', function(){
        if (cmp.length < 2) { if (cmpLabel) cmpLabel.textContent = 'Compare: pick at least 2'; return; }
        var rows = [['', 'Name'], ['', 'Price'], ['', 'Was'], ['', 'Discount'], ['', 'Rating'], ['', 'Sold'], ['', 'Category'], ['', 'Tag']];
        var head = '<tr><th style="text-align:left;padding:.5rem;color:var(--dim)"></th>' + cmp.map(function(i){ return '<th style="text-align:left;padding:.5rem;min-width:150px"><img src="' + products[i].img + '" alt="" width="54" height="54" style="border-radius:10px;object-fit:cover;display:block;margin-bottom:.3rem">' + esc(products[i].name) + '</th>'; }).join('') + '</tr>';
        function row(label, fn){ return '<tr><td style="padding:.5rem;color:var(--dim);font-weight:700">' + label + '</td>' + cmp.map(function(i){ return '<td style="padding:.5rem">' + fn(products[i]) + '</td>'; }).join('') + '</tr>'; }
        var body = row('Price', function(p){ return '<strong>$' + (+p.price).toFixed(2) + '</strong> USD'; })
          + row('Was', function(p){ return '$' + (+p.oldPrice).toFixed(2); })
          + row('Discount', function(p){ return '-' + p.off + '%'; })
          + row('Rating', function(p){ return '★ ' + p.rating; })
          + row('Sold', function(p){ return esc(p.sold || '—'); })
          + row('Category', function(p){ return esc(p.catLabels); })
          + row('Tag', function(p){ return esc(p.tag); })
          + '<tr><td></td>' + cmp.map(function(i){ return '<td style="padding:.5rem"><a class="shop-now shop-now-link" data-product="' + esc(products[i].name) + '" href="' + products[i].url + '" target="_blank" rel="sponsored nofollow noopener" style="display:block;padding:.55rem">SHOP NOW →</a></td>'; }).join('') + '</tr>';
        document.getElementById('cmpTable').innerHTML = '<table style="border-collapse:collapse;width:100%">' + head + body + '</table>';
        document.querySelectorAll('#cmpTable .shop-now-link').forEach(function(a){ a.addEventListener('click', function(){ track('affiliate_click', { product: a.getAttribute('data-product') || '' }); }); });
        if (cmpDlg.showModal) cmpDlg.showModal();
      });
      paintCmp();

      /* ---------- RECENTLY VIEWED ---------- */
      var recent = [];
      try { recent = JSON.parse(localStorage.getItem('irfan-recent') || '[]'); } catch(e){}
      var recentBox = document.getElementById('recentBox'), recentRow = document.getElementById('recentRow');
      function paintRecent(){
        if (!recentBox || !recentRow) return;
        recentBox.classList.toggle('show', recent.length > 0);
        recentRow.innerHTML = recent.map(function(i){ var p = products[i]; if (!p) return ''; return '<button type="button" class="recent-chip" data-recent="' + i + '"><img src="' + p.img + '" alt="" width="26" height="26">' + esc(p.name) + '</button>'; }).join('');
        recentRow.querySelectorAll('[data-recent]').forEach(function(b){ b.addEventListener('click', function(){ openDetails(+b.getAttribute('data-recent')); }); });
      }
      var baseOpen = openDetails;
      openDetails = function(i){
        baseOpen(i);
        recent = [i].concat(recent.filter(function(x){ return x !== i; })).slice(0, 6);
        try { localStorage.setItem('irfan-recent', JSON.stringify(recent)); } catch(e){}
        paintRecent();
        /* modal extras: alternatives + pairs + share/wish wiring */
        var p = products[i]; if (!p) return;
        var alt = products.filter(function(x){ return x !== p && x.vis !== false && (x.cats || []).some(function(c){ return (p.cats || []).indexOf(c) !== -1; }); }).slice(0, 2);
        var altBox = document.getElementById('pdAlt');
        if (altBox) altBox.innerHTML = alt.length ? '<p style="font-weight:800;font-size:.88rem;margin:0 0 .4rem">More in this category</p>' + alt.map(function(x){ return '<button type="button" class="recent-chip" data-alt="' + products.indexOf(x) + '" style="margin:0 .4rem .4rem 0"><img src="' + x.img + '" alt="" width="26" height="26">' + esc(x.name) + ' · $' + (+x.price).toFixed(2) + '</button>'; }).join('') : '';
        if (altBox) altBox.querySelectorAll('[data-alt]').forEach(function(b){ b.addEventListener('click', function(){ openDetails(+b.getAttribute('data-alt')); }); });
        var pair = products.filter(function(x){ return x !== p && x.vis !== false && !(x.cats || []).some(function(c){ return (p.cats || []).indexOf(c) !== -1; }); }).sort(function(a, b){ return b.rating - a.rating; })[0];
        var pairBox = document.getElementById('pdPair');
        if (pairBox) pairBox.innerHTML = pair ? '<p style="font-weight:800;font-size:.88rem;margin:0 0 .4rem">Pairs well with</p><button type="button" class="recent-chip" data-alt="' + products.indexOf(pair) + '"><img src="' + pair.img + '" alt="" width="26" height="26">' + esc(pair.name) + ' · $' + (+pair.price).toFixed(2) + '</button>' : '';
        if (pairBox) pairBox.querySelectorAll('[data-alt]').forEach(function(b){ b.addEventListener('click', function(){ openDetails(+b.getAttribute('data-alt')); }); });
        var shareBtn = document.getElementById('pdShare');
        if (shareBtn) shareBtn.onclick = function(){
          var url = location.origin + '/store/';
          if (navigator.share) { navigator.share({ title: p.name + ' — IRFAN-GD', text: p.name + ' · $' + (+p.price).toFixed(2) + ' USD at IRFAN-GD', url: url }).catch(function(){}); }
          else if (navigator.clipboard) { navigator.clipboard.writeText(url); shareBtn.textContent = '✓ Link copied'; setTimeout(function(){ shareBtn.textContent = '↗ Share'; }, 1600); }
        };
        var wishBtn = document.getElementById('pdWish');
        if (wishBtn) {
          wishBtn.textContent = wish.has(i) ? '♥ In Wishlist' : '♡ Save to Wishlist';
          wishBtn.onclick = function(){ if (wish.has(i)) wish.delete(i); else wish.add(i); saveWish(); paintWish(); wishBtn.textContent = wish.has(i) ? '♥ In Wishlist' : '♡ Save to Wishlist'; if (state.wishOnly) apply(); };
        }
      };
      paintRecent();

      /* ---------- GIFT FINDER + COLLECTIONS ---------- */
      function scrollShop(){ var s = document.getElementById('shop'); if (s) s.scrollIntoView({ behavior: 'smooth' }); }
      var giftGo = document.getElementById('giftGo');
      if (giftGo) giftGo.addEventListener('click', function(){
        var cat = document.getElementById('giftFor').value;
        var budget = +document.getElementById('giftBudget').value;
        setCat(cat);
        state.maxPrice = budget;
        if (priceEl) priceEl.value = budget;
        if (priceLabel) priceLabel.textContent = 'Up to $' + budget;
        apply(); scrollShop(); track('gift_finder', { category: cat, budget: budget });
      });
      document.querySelectorAll('[data-collection]').forEach(function(b){
        b.addEventListener('click', function(){
          var kind = b.getAttribute('data-collection');
          if (kind === 'creator') { setCat('creator-equipment'); }
          else { setCat('car-tech'); }
          state.maxPrice = 25; if (priceEl) priceEl.value = 25; if (priceLabel) priceLabel.textContent = 'Up to $25';
          apply(); scrollShop(); track('collection_open', { collection: kind });
        });
      });

      apply();
    })();
  </script>

  <style is:inline>
    .store-ad{max-width:880px;margin:22px auto 6px;text-align:center}
    .store-ad .adlbl{display:block;font-size:10px;letter-spacing:.22em;color:#8b8b90;margin-bottom:6px}
    .store-ad .adbox{min-height:60px;display:flex;align-items:center;justify-content:center}
    .store-ad iframe{max-width:100%}
  </style>
</StoreLayout>
