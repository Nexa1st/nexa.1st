---
import BaseLayout from '../layouts/BaseLayout.astro';
import store from '../data/store.json';
const products = store.products.map(p => ({ ...p, off: Math.round((1 - p.price / p.oldPrice) * 100) }));
---
<BaseLayout title="Store — AliExpress Gadget Picks & Deals" description="The NEXA store: hand-picked AliExpress gadgets with real ratings, current deal prices and direct Shop Now links. Prices checked 10 Nov 2026; affiliate disclosure inside.">
  <div class="mx-auto" style="max-width:1200px;padding:2.5rem 1rem 0">
    <h1 class="font-display" style="font-size:2.6rem;font-weight:900">🛒 NEXA Store — Gadget Picks</h1>
    <section aria-label="About this store" class="glass" style="padding:20px;margin-top:1rem">
      <h2 style="font-weight:850">Hand-picked AliExpress deals</h2>
      <p class="text-dim" style="margin-top:.4rem;line-height:1.7">Every product below was picked from trending AliExpress listings that ship to the USA. Prices, ratings and sold counts are as listed on AliExpress when this page was last updated ({store.updated}); AliExpress prices change often, so the price on the product page is the one that counts. New picks are added as our daily product research finds them.</p>
    </section>
    <div class="glass" style="padding:16px;margin:1rem 0" role="note">
      <strong>Disclosure:</strong> The Shop Now buttons are AliExpress affiliate links. If you buy through one, NEXA may earn a commission at no extra cost to you. Full details: <a href="/disclosure/" style="text-decoration:underline">Affiliate Disclosure</a>.
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr));gap:1rem;margin-top:1rem">
      {products.map(p => (
        <article class="glass" style="padding:16px;display:flex;flex-direction:column">
          <div style="position:relative;border-radius:16px;overflow:hidden">
            <img src={p.img} alt={p.name} loading="lazy" width="640" height="640" style="width:100%;height:auto;display:block" />
            <span style="position:absolute;top:10px;left:10px;background:#f5b301;color:#111;font-weight:800;font-size:.8rem;padding:.25rem .55rem;border-radius:999px">-{p.off}%</span>
          </div>
          <h2 style="font-weight:800;margin:.7rem 0 .3rem;font-size:1.08rem">{p.name}</h2>
          <p class="text-dim" style="font-size:.92rem;line-height:1.55">{p.blurb}</p>
          <p style="margin-top:.55rem;display:flex;gap:6px;flex-wrap:wrap">
            <span class="chip">★ {p.rating} on AliExpress</span>
            {p.sold && <span class="chip">{p.sold}</span>}
          </p>
          <p style="margin-top:.7rem;display:flex;align-items:baseline;gap:.55rem">
            <span style="font-size:1.45rem;font-weight:900">${p.price.toFixed(2)}</span>
            <span class="text-faint" style="text-decoration:line-through">${p.oldPrice.toFixed(2)}</span>
          </p>
          <a href={p.url} target="_blank" rel="sponsored nofollow noopener" style="margin-top:.8rem;display:block;text-align:center;background:#f5b301;color:#111;font-weight:850;padding:.75rem 1rem;border-radius:14px">SHOP NOW →</a>
        </article>
      ))}
    </div>
    <p class="text-faint" style="font-size:.82rem;margin:1.4rem 0 2.5rem">Prices and availability can change at any time on AliExpress. NEXA does not sell or ship these products; orders, payments, shipping and returns are handled by AliExpress and the individual sellers.</p>
  </div>
</BaseLayout>
