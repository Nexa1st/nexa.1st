    html[data-style="glass"] .tabs a.on:hover{color:#fff}
    html[data-style="glass"] #themeToggle{background:rgba(255,255,255,.7)}
    html[data-style="glass"] .stylebar button{background:rgba(255,255,255,.6);color:#5a5f78}
    html[data-style="glass"] .stylebar button.on{color:#fff;border-color:#7c5cff;background:linear-gradient(120deg,rgba(139,92,246,.9),rgba(109,40,217,.9))}
    html[data-style="glass"] .stylebar button:hover{color:#23263a}
    html[data-style="glass"] .searchbar{border-radius:999px}
    html[data-style="glass"] .plan{background:linear-gradient(150deg,#2e2456,#17122e);border-color:rgba(139,92,246,.5);box-shadow:0 14px 32px rgba(76,45,180,.35)}
    html[data-style="glass"] .plan b{color:#fff}
    html[data-style="glass"] .plan p{color:#c9c2f0}
    html[data-style="glass"] .plan .bar{background:rgba(255,255,255,.18)}
    html[data-style="glass"] .plan .bar i{background:linear-gradient(90deg,#a78bfa,#e9d5ff)}
    html[data-style="glass"] .gauge svg circle:first-child{stroke:rgba(124,92,255,.16)}
    html[data-style="glass"] .gauge text{fill:#23263a}
    html[data-style="glass"] .gauge .gl{color:#6b7086}
    html[data-style="glass"] .gauge .gv{color:#23263a}
    html[data-style="glass"] .donut-wrap svg circle:first-child{stroke:rgba(124,92,255,.16)}
    html[data-style="glass"] .donut-wrap svg text{fill:#6b7086}
    html[data-style="glass"] .donut-wrap #donutTotal{fill:#23263a}
    html[data-style="glass"] .legend{color:#5a5f78}
    /* Glass in Night mode — darkened frosted panels, same layout & accents */
    html[data-style="glass"][data-theme="night"]{--txt:#eceaf6;--dim:#b3aed0;--dim2:#8a84a8;--stroke:rgba(180,160,255,.20);--stroke2:rgba(180,160,255,.38);--gold:#a78bfa;--gold2:#c4b5fd;--green:#34d399;--amber:#f0b429;--red:#ff8a8a}
    html[data-style="glass"][data-theme="night"] .glass.light{color:#eceaf6}
    html[data-style="glass"][data-theme="night"] body{background:radial-gradient(1000px 620px at 88% -12%, rgba(124,92,255,.30), transparent 60%),radial-gradient(900px 700px at -12% 22%, rgba(80,60,160,.35), transparent 58%),radial-gradient(850px 650px at 55% 118%, rgba(50,35,110,.40), transparent 60%),linear-gradient(160deg,#1b1626 0%, #14101f 55%, #0e0b16 100%)}
    html[data-style="glass"][data-theme="night"] .side{background:linear-gradient(180deg,rgba(30,24,52,.85),rgba(22,18,40,.75));border-right-color:rgba(180,160,255,.16)}
    html[data-style="glass"][data-theme="night"] .glass{--panel:rgba(46,38,80,.55);--panel2:rgba(34,28,62,.45);background:linear-gradient(155deg,rgba(46,38,80,.58),rgba(34,28,62,.46));border-color:rgba(180,160,255,.20);box-shadow:0 18px 40px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.08)}
    html[data-style="glass"][data-theme="night"] .glass.light{background:linear-gradient(150deg,rgba(58,48,96,.85),rgba(44,36,76,.82));border-color:rgba(180,160,255,.18)}
    html[data-style="glass"][data-theme="night"] .glass.light h2, html[data-style="glass"][data-theme="night"] .glass.light h3{color:#eceaf6}
    html[data-style="glass"][data-theme="night"] .glass.light p, html[data-style="glass"][data-theme="night"] .glass.light .pmeta{color:#b3aed0}
    html[data-style="glass"][data-theme="night"] .glass.light .chart-note{color:#8a84a8}
    html[data-style="glass"][data-theme="night"] .stat.light .lbl{color:#b3aed0}
    html[data-style="glass"][data-theme="night"] .stat.light .hint{color:#8a84a8}
    html[data-style="glass"][data-theme="night"] .ann .when{color:#8a84a8}
    html[data-style="glass"][data-theme="night"] .nav a{color:#b3aed0}
    html[data-style="glass"][data-theme="night"] .nav a.on{color:#fff;background:linear-gradient(120deg,rgba(139,92,246,.35),rgba(139,92,246,.15));border-color:rgba(180,160,255,.30)}
    html[data-style="glass"][data-theme="night"] .nav a:hover{color:#fff}
    html[data-style="glass"][data-theme="night"] .nav a .cnt{background:rgba(180,160,255,.14)}
    html[data-style="glass"][data-theme="night"] .chip{background:rgba(46,38,80,.6);color:#b3aed0}
    html[data-style="glass"][data-theme="night"] .chip b{color:#fff}
    html[data-style="glass"][data-theme="night"] td, html[data-style="glass"][data-theme="night"] th{border-bottom-color:rgba(180,160,255,.14);color:#dfe0f2}
    html[data-style="glass"][data-theme="night"] .notice code{background:rgba(255,255,255,.08);color:#dfe0f2}
    html[data-style="glass"][data-theme="night"] input[type=file]{color:#dfe0f2}
    html[data-style="glass"][data-theme="night"] .minirow{border-bottom-color:rgba(180,160,255,.12)}
    html[data-style="glass"][data-theme="night"] .btn-ghost{background:rgba(255,255,255,.08);color:#eceaf6}
    html[data-style="glass"][data-theme="night"] .qa a, html[data-style="glass"][data-theme="night"] .qa button{background:rgba(46,38,80,.6);color:#eceaf6}
    html[data-style="glass"][data-theme="night"] .feat button{background:rgba(46,38,80,.6);color:#eceaf6}
    html[data-style="glass"][data-theme="night"] .tabs a{background:rgba(46,38,80,.55);color:#b3aed0}
    html[data-style="glass"][data-theme="night"] .tabs a.on{background:linear-gradient(120deg,#8b5cf6,#6d28d9);color:#fff}
    html[data-style="glass"][data-theme="night"] .tabs a:hover{color:#fff}
    html[data-style="glass"][data-theme="night"] #themeToggle{background:rgba(255,255,255,.10)}
    html[data-style="glass"][data-theme="night"] .stylebar button{background:rgba(46,38,80,.6);color:#b3aed0}
    html[data-style="glass"][data-theme="night"] .stylebar button:hover{color:#fff}
    html[data-style="glass"][data-theme="night"] .gauge svg circle:first-child{stroke:rgba(180,160,255,.18)}
    html[data-style="glass"][data-theme="night"] .gauge text{fill:#eceaf6}
    html[data-style="glass"][data-theme="night"] .gauge .gl{color:#8a84a8}
    html[data-style="glass"][data-theme="night"] .gauge .gv{color:#eceaf6}
    html[data-style="glass"][data-theme="night"] .donut-wrap svg circle:first-child{stroke:rgba(180,160,255,.18)}
    html[data-style="glass"][data-theme="night"] .donut-wrap svg text{fill:#8a84a8}
    html[data-style="glass"][data-theme="night"] .donut-wrap #donutTotal{fill:#eceaf6}
    html[data-style="glass"][data-theme="night"] .legend{color:#b3aed0}
    /* ---------- Motion pack: entrance, hover, charts, theme cross-fade ---------- */
    @keyframes dashFadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
    @keyframes planGlow{0%,100%{box-shadow:0 14px 32px rgba(76,45,180,.35),0 0 0 rgba(139,92,246,0)}50%{box-shadow:0 14px 34px rgba(76,45,180,.48),0 0 26px 4px rgba(139,92,246,.30)}}
    /* Entrance: staggered fade-up on load (fill backwards so hover transforms still work after) */
    .side,.searchbar,.topbar,.qa,.stylebar,.feat,.tabs,.notice{animation:dashFadeUp .5s cubic-bezier(.22,.61,.36,1) backwards}
    .side{animation-delay:0s}
    .searchbar{animation-delay:.03s}
    .topbar{animation-delay:.07s}
    .qa{animation-delay:.11s}
    .stylebar{animation-delay:.15s}
    .feat{animation-delay:.19s}
    .tabs{animation-delay:.23s}
    .notice{animation-delay:.27s}
    .col-main>.grid2>.card:nth-child(1){animation:dashFadeUp .5s cubic-bezier(.22,.61,.36,1) .30s backwards}
    .col-main>.grid2>.card:nth-child(2){animation:dashFadeUp .5s cubic-bezier(.22,.61,.36,1) .36s backwards}
    .stats .stat{animation:dashFadeUp .5s cubic-bezier(.22,.61,.36,1) backwards}
    .stats .stat:nth-child(1){animation-delay:.32s}
    .stats .stat:nth-child(2){animation-delay:.37s}
    .stats .stat:nth-child(3){animation-delay:.42s}
    .stats .stat:nth-child(4){animation-delay:.47s}
    .stats .stat:nth-child(5){animation-delay:.52s}
    .stats .stat:nth-child(6){animation-delay:.57s}
    .stats .stat:nth-child(7){animation-delay:.62s}
    .stats .stat:nth-child(8){animation-delay:.67s}
    .col-main>section.glass.card{animation:dashFadeUp .5s cubic-bezier(.22,.61,.36,1) .55s backwards}
    .col-rail>.card{animation:dashFadeUp .5s cubic-bezier(.22,.61,.36,1) backwards}
    .col-rail>.card:nth-child(1){animation-delay:.40s}
    .col-rail>.card:nth-child(2){animation-delay:.48s}
    .main>.grid2>.card{animation:dashFadeUp .5s cubic-bezier(.22,.61,.36,1) backwards}
    .main>.grid2>.card:nth-child(1){animation-delay:.52s}
    .main>.grid2>.card:nth-child(2){animation-delay:.58s}
    #catalogue{animation:dashFadeUp .5s cubic-bezier(.22,.61,.36,1) .62s backwards}
    #announcements .ann{animation:dashFadeUp .5s cubic-bezier(.22,.61,.36,1) backwards}
    #announcements .ann:nth-child(2){animation-delay:.64s}
    #announcements .ann:nth-child(3){animation-delay:.69s}
    #announcements .ann:nth-child(4){animation-delay:.74s}
    #announcements .ann:nth-child(5){animation-delay:.79s}
    #activity{animation:dashFadeUp .5s cubic-bezier(.22,.61,.36,1) .70s backwards}
    /* Theme/style cross-fade: colors, borders and shadows ease instead of snapping (gradients still snap — CSS cannot interpolate them) */
    body,.side,.chip,.nav a,.plan,.searchbar,.minirow,td,th,.notice code,input[type=file]{transition:background-color .35s ease,color .35s ease,border-color .35s ease,box-shadow .35s ease}
    .glass{transition:transform .25s ease,box-shadow .25s ease,background-color .35s ease,border-color .35s ease,color .35s ease}
    .stat{transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease,background-color .35s ease,color .35s ease}
    /* Hover: lift + soft violet glow */
    .stat:hover{transform:translateY(-4px);border-color:var(--stroke2);box-shadow:0 16px 32px rgba(124,92,255,.22)}
    .grid2>.card:hover,.col-rail>.card:hover,.col-main>section.glass.card:hover,.pcard:hover,.ann:hover{transform:translateY(-3px);box-shadow:0 20px 38px rgba(90,70,160,.18),inset 0 1px 0 rgba(255,255,255,.85)}
    button{transition:transform .2s ease,filter .2s ease,box-shadow .2s ease}
    button:hover{filter:brightness(1.06);transform:translateY(-1px)}
    .qa a,.qa button,.feat button,.tabs a,.stylebar button,.btn-dark,.btn-ghost,#themeToggle{transition:transform .2s ease,box-shadow .2s ease,border-color .25s ease,background-color .35s ease,color .35s ease}
    .qa a:hover,.qa button:hover,.feat button:hover,.tabs a:hover,.stylebar button:hover,.btn-dark:hover,.btn-ghost:hover,#themeToggle:hover{transform:translateY(-1px)}
    .feat button:hover{box-shadow:0 8px 18px rgba(124,92,255,.20)}
    /* Chart bars grow on render; rings + donut sweep */
    .bigbars .bar,.bars .bar{transition:height .6s cubic-bezier(.22,.61,.36,1)}
    .bigbars .bar:hover{filter:brightness(1.13)}
    #ringEarn,#ringClicks,.gauge svg circle{transition:stroke-dasharray .8s cubic-bezier(.22,.61,.36,1),stroke-dashoffset .8s cubic-bezier(.22,.61,.36,1)}
    #donutSegs circle{transition:stroke-dasharray .8s cubic-bezier(.22,.61,.36,1),stroke-dashoffset .8s cubic-bezier(.22,.61,.36,1)}
    /* Dark Free-plan card: slow glowing pulse, echoing the reference's glowing promo card */
    html[data-style="glass"] .plan{animation:planGlow 3.2s ease-in-out infinite}
    /* Focus + press states */
    :focus-visible{outline:2px solid var(--violet);outline-offset:2px}
    button:active,.qa a:active,.qa button:active,.feat button:active,.tabs a:active,.stylebar button:active,.btn-dark:active,.btn-ghost:active,#themeToggle:active{transform:translateY(0) scale(.97)}
  </style>
</head>
<body>
  <div class="shell">
    <aside class="side">
      <div class="lights" aria-hidden="true"><i class="r"></i><i class="y"></i><i class="g"></i></div>
      <div class="brand">
        <img src="/store/avatar.webp" alt="IRFAN-GD logo" width="40" height="40" />
        <div><b>IRFAN-GD</b><span>Admin V2</span></div>
      </div>
      <nav class="nav" aria-label="Dashboard">
        <div class="grp">Dashboard</div>
        <a href="/irfan-admin/" class="on"><i>▦</i> Overview</a>
        <a href="#analytics"><i>📊</i> Analytics</a>
        <div class="grp">Manage</div>
        <a href="/store/"><i>🛍️</i> Storefront</a>
        <a href="#catalogue"><i>🏷️</i> Products <span class="cnt">{vis.length + hidden.length}</span></a>
        <a href="#announcements"><i>📣</i> Announcements <span class="cnt">{announcements.length}</span></a>
        <a href="#import"><i>📥</i> Imports</a>
        <div class="grp">System</div>
        <a href="#activity"><i>🧾</i> Activity log</a>
        <a href="/#tools"><i>🧰</i> Tools <span class="chev">›</span></a>
        <a href="/disclosure/"><i>📄</i> Disclosure</a>
        <a href="/privacy/"><i>🔒</i> Privacy</a>
        <a href="/"><i>⚙️</i> NEXA site <span class="chev">›</span></a>
      </nav>
      <div class="plan">
        <b>🚀 Free plan — $0</b>
        <p>Catalogue slots used: {vis.length + hidden.length} products on the free stack. Weekly refresh runs Mondays.</p>
        <div class="bar"><i style={`width:${Math.round(vis.length / (vis.length + hidden.length) * 100)}%`}></i></div>
        <p style="margin:.45rem 0 0">{Math.round(vis.length / (vis.length + hidden.length) * 100)}% of the catalogue is live</p>
      </div>
      <p class="foot">Affiliate showcase — sales happen on AliExpress.<br /><a href="/store/">← Back to the store</a></p>
    </aside>

    <main class="main">
     <div class="layout">
      <div class="col-main">
      <div class="glass searchbar" role="search">
        <span class="mag" aria-hidden="true">🔍</span>
        <input id="dashSearch" type="search" placeholder="Search products in the catalogue…" aria-label="Search products in the catalogue" />
        <button type="button" id="themeToggle" aria-label="Switch between day and night theme">🌙 Night</button>
        <img class="avatar" src="/store/avatar.webp" alt="IRFAN-GD" width="38" height="38" />
      </div>
      <div class="topbar">
        <div>
          <h1>{greetWord}, Irfan</h1>
          <p class="sub">{dateLine} · IRFAN-GD business dashboard — affiliate clicks, top products &amp; imported earnings, real figures only.</p>
        </div>
        <div class="chiprow">
          <span class="chip"><span class="dot"></span> Mode: <b id="whoami">checking…</b></span>
          <span class="chip">Last GA4 sync: <b id="lastSync">—</b></span>
        </div>
      </div>
      <div class="qa" aria-label="Quick actions">
        <a href="/store/">🛍️ View store</a>
        <a href="#catalogue">🏷️ Products</a>
        <a href="#import">📥 Import CSV</a>
        <button type="button" class="off" disabled title="New products are added only with the owner's approval (weekly refresh)">＋ Add product</button>
      </div>
      <div class="stylebar" id="styleBar" aria-label="Theme styles">
        <span class="slbl">🎨 Style</span>
        <button type="button" data-style-pick="current"><span class="sw" style="background:linear-gradient(135deg,#12566b,#38e1ff)"></span>Current</button>
        <button type="button" data-style-pick="glass"><span class="sw" style="background:linear-gradient(135deg,#f6f4fc,#a78bfa)"></span>Glass</button>
        <button type="button" data-style-pick="sequoia"><span class="sw" style="background:linear-gradient(135deg,#ffd9a0,#f0a35e)"></span>Sequoia</button>
        <button type="button" data-style-pick="sonoma"><span class="sw" style="background:linear-gradient(135deg,#c9f2d4,#5ecf8a)"></span>Sonoma</button>
        <button type="button" data-style-pick="ventura"><span class="sw" style="background:linear-gradient(135deg,#eaf5ff,#7db9f0)"></span>Ventura</button>
        <button type="button" data-style-pick="catalina"><span class="sw" style="background:linear-gradient(135deg,#efe6ff,#b18cff)"></span>Catalina</button>
        <button type="button" data-style-pick="mojave"><span class="sw" style="background:linear-gradient(135deg,#fdf3d0,#e3b959)"></span>Mojave</button>
        <button type="button" data-style-pick="bigsur"><span class="sw" style="background:linear-gradient(135deg,#ffe3ec,#ff8fb5)"></span>Big Sur</button>
        <button type="button" data-style-pick="tahoe"><span class="sw" style="background:linear-gradient(135deg,#16294d,#4f8cff)"></span>Tahoe</button>
        <button type="button" data-style-pick="graphite"><span class="sw" style="background:linear-gradient(135deg,#3d3d44,#101013)"></span>Graphite</button>
      </div>
      <div class="feat" aria-label="Dashboard tools">
        <button type="button" id="btnShare">🔗 Copy dashboard link</button>
        <button type="button" id="btnExport">⬇️ Export summary (.txt)</button>
        <button type="button" id="btnPrint">🖨️ Print view</button>
        <button type="button" id="btnDensity">🗜️ Compact view</button>
        <button type="button" class="warnb" id="btnRefresh">↻ Refresh data</button>
      </div>
      <nav class="tabs" aria-label="Dashboard views">
        <a href="/irfan-admin/" class="on">Overview</a>
        <a href="#analytics">Analytics</a>
        <a href="#catalogue">Products</a>
        <a href="#announcements">Announcements</a>
        <a href="#import">Imports</a>
        <a href="#activity">Activity log</a>
      </nav>

      <section class="glass notice" role="note">
        <strong>📊 IRFAN-GD is an AliExpress affiliate showcase.</strong>
        <p>This dashboard shows only: affiliate clicks (from GA4), top-performing products, and earnings <em>imported by the owner from official AliExpress Portals reports</em>. IRFAN-GD never collects payments and never sees customer payment data. Panels show <span class="unavail">NOT CONNECTED</span> until the D1 database is connected — no figure on this page is estimated or fabricated. <strong>Access mode (owner decision, 2026-11-11): viewing is currently open without a login</strong> — the owner chose to run the dashboard without the Cloudflare Access lock for now. Actions that change data (CSV import, manual sync) stay <strong>disabled</strong> until the owner configures the Access lock; configuring it later re-secures this page automatically. This page is not linked from the public site and carries <code>noindex</code>.</p>
      </section>

      <div class="grid2" id="analytics">
        <section class="glass card light" aria-label="Clicks chart">
          <h2><i>📊</i> Clicks — Last 30 Days, by Period</h2>
          <div id="bars" class="bigbars" role="img" aria-label="Affiliate clicks by 5-day period, bar chart"></div>
          <p class="chart-note" id="barsNote">Six bars — one per 5-day period. They fill in after the first GA4 sync.</p>
        </section>
        <section class="glass card light" aria-label="Click share">
          <h2><i>🎯</i> Click Share by Product</h2>
          <div class="donut-wrap">
            <svg width="150" height="150" viewBox="0 0 120 120" role="img" aria-label="Donut chart of click share by product">
              <circle cx="60" cy="60" r="46" fill="none" stroke="rgba(23,50,63,.14)" stroke-width="16"></circle>
              <g id="donutSegs"></g>
              <text id="donutTotal" x="60" y="58" text-anchor="middle" font-size="17" font-weight="800" fill="#17323f">0</text>
              <text x="60" y="76" text-anchor="middle" font-size="8.5" fill="#5d7f8f">CLICKS · 30D</text>
            </svg>
            <ul id="donutLegend" class="legend"></ul>
          </div>
          <p class="chart-note" id="donutNote">Share appears after the first GA4 sync.</p>
        </section>
      </div>

      <section class="stats" aria-label="Key figures">
        <div class="glass stat light" style="--acc:#4f8cff">
          <div class="lbl">Affiliate clicks · 7 days <i>🖱️</i></div>
          <div class="val mono" id="clicks7">—</div>
          <div class="hint">From GA4, synced daily</div>
        </div>
        <div class="glass stat light" style="--acc:#38e1ff">
          <div class="lbl">Affiliate clicks · 30 days <i>📈</i></div>
          <div class="val mono" id="clicks30">—</div>
          <div class="hint">Rolling 30-day total</div>
        </div>
        <div class="glass stat light" style="--acc:#8b5cf6">
          <div class="lbl">Products live <i>🛍️</i></div>
          <div class="val">{vis.length}</div>
          <div class="hint">{hidden.length} hidden — records kept</div>
        </div>
        <div class="glass stat light" style="--acc:#34d399">
          <div class="lbl">Imported earnings <i>💰</i></div>
          <div class="val mono" id="earnTotal">—</div>
          <div class="hint"><span id="earnRows">0</span> report rows · last import: <span id="earnLast">never</span></div>
        </div>
        <div class="glass stat light" style="--acc:#e2603f">
          <div class="lbl">Products hidden <i>🙈</i></div>
          <div class="val">{hidden.length}</div>
          <div class="hint">Records + links kept, never deleted</div>
        </div>
        <div class="glass stat light" style="--acc:#2b9dbd">
          <div class="lbl">Catalogue live share <i>🎯</i></div>
          <div class="val">{Math.round(vis.length / (vis.length + hidden.length) * 100)}%</div>
          <div class="hint">{vis.length} of {vis.length + hidden.length} products on the storefront</div>
        </div>
        <div class="glass stat light" style="--acc:#b98a1f">
          <div class="lbl">Report rows imported <i>📥</i></div>
          <div class="val mono" id="earnRowsCard">0</div>
          <div class="hint">From official Portals CSV reports</div>
        </div>
        <div class="glass stat light" style="--acc:#7fb069">
          <div class="lbl">Data sources live <i>🔌</i></div>
          <div class="val">2<span style="font-size:1rem;color:#5d7f8f"> / 3</span></div>
          <div class="hint">Store catalogue ✓ · Database ✓ · GA4 sync — pending first run</div>
        </div>
      </section>

      <section class="glass card" style="margin-bottom:1.1rem" aria-label="Progress rings">
        <h2><i>🎯</i> Progress Rings</h2>
        <div class="gauges">
          <div class="gauge">
            <svg width="104" height="104" viewBox="0 0 104 104" role="img" aria-label="Imported earnings progress ring">
              <circle cx="52" cy="52" r="42" fill="none" stroke="rgba(160,225,245,.16)" stroke-width="10"></circle>
              <circle id="ringEarn" cx="52" cy="52" r="42" fill="none" stroke="#1d9e75" stroke-width="10" stroke-linecap="round" pathLength="100" stroke-dasharray="0 100" transform="rotate(-90 52 52)"></circle>
              <text id="ringEarnPct" x="52" y="58" text-anchor="middle" font-size="16" font-weight="800" fill="#f2fbff">0%</text>
            </svg>
            <div class="gv" id="earnGoalVal">$0.00</div>
            <div class="gl">of first $100 earnings</div>
          </div>
          <div class="gauge">
            <svg width="104" height="104" viewBox="0 0 104 104" role="img" aria-label="Clicks progress ring">
              <circle cx="52" cy="52" r="42" fill="none" stroke="rgba(160,225,245,.16)" stroke-width="10"></circle>
              <circle id="ringClicks" cx="52" cy="52" r="42" fill="none" stroke="#bd8524" stroke-width="10" stroke-linecap="round" pathLength="100" stroke-dasharray="0 100" transform="rotate(-90 52 52)"></circle>
              <text id="ringClicksPct" x="52" y="58" text-anchor="middle" font-size="16" font-weight="800" fill="#f2fbff">0%</text>
            </svg>
            <div class="gv" id="clicksGoalVal">0</div>
            <div class="gl">of 1,000 clicks · 30 days</div>
          </div>
          <div class="gauge">
            <svg width="104" height="104" viewBox="0 0 104 104" role="img" aria-label="Catalogue live share ring">
              <circle cx="52" cy="52" r="42" fill="none" stroke="rgba(160,225,245,.16)" stroke-width="10"></circle>
              <circle cx="52" cy="52" r="42" fill="none" stroke="#8b5cf6" stroke-width="10" stroke-linecap="round" pathLength="100" stroke-dasharray={`${Math.round(vis.length / (vis.length + hidden.length) * 100)} 100`} transform="rotate(-90 52 52)"></circle>
              <text x="52" y="58" text-anchor="middle" font-size="16" font-weight="800" fill="#f2fbff">{Math.round(vis.length / (vis.length + hidden.length) * 100)}%</text>
            </svg>
            <div class="gv">{vis.length} of {vis.length + hidden.length}</div>
            <div class="gl">products live in catalogue</div>
          </div>
        </div>
        <p class="chart-note">Starter goals only — rings fill from the real figures above; nothing here is a projection.</p>
      </section>

      </div>
      <aside class="col-rail">
        <section class="glass card" aria-label="Top products summary">
          <h2><i>🏆</i> Top Products</h2>
          <div id="railTop"><p class="chart-note">Figures appear after the first GA4 sync.</p></div>
          <p style="margin-top:.8rem"><button type="button" id="syncBtn">Sync GA4 now</button> <span id="syncMsg" role="status"></span></p>
        </section>
        <section class="glass card" aria-label="Recent activity">
          <h2><i>🧾</i> Recent Activity</h2>
          <div id="railLog"><p class="chart-note">No activity recorded yet.</p></div>
        </section>
      </aside>
     </div>
      <div class="grid2">
        <section class="glass card" aria-label="Top products">
          <h2><i>🏆</i> Top-Performing Products</h2>
          <table id="topTable"><tr><th>Product</th><th>Clicks (30d)</th></tr><tr><td colspan="2"><span class="unavail">NOT CONNECTED</span> — figures appear after the first GA4 sync.</td></tr></table>
          <p style="margin-top:.9rem"><button type="button" id="syncBtn2">Sync GA4 now</button> <span id="syncMsg2" role="status"></span></p>
        </section>

        <section class="glass card" id="import" aria-label="Earnings imports">
          <h2><i>📥</i> Earnings — Portals CSV Import</h2>
          <form id="importForm">
            <label style="display:block;font-weight:700;font-size:.92rem">Import a Portals CSV report (max 2 MB — enabled once the Access lock is configured)
              <input type="file" id="csvFile" name="file" accept=".csv,text/csv" required style="display:block;margin-top:.5rem" />
            </label>
            <p style="margin:.6rem 0"><button type="submit" id="importBtn">Import CSV</button> <span id="importMsg" role="status"></span></p>
            <p>Validation: file type and size checked server-side; the file's SHA-256 hash is recorded, so the same file can never be imported twice; each row is checked (date, product, amount) and duplicate rows are skipped and counted; a malformed file is rejected completely — nothing is partially imported. Imported rows are stored in the D1 database. While the dashboard runs without the Access lock, importing stays disabled so nobody can alter the figures.</p>
          </form>
        </section>
      </div>

      <section class="glass card" id="catalogue" style="margin-bottom:1.1rem" aria-label="Product catalogue">
        <h2><i>🗂️</i> Product Catalogue</h2>
        <div class="pcards">
          {(store.products as any[]).map(p => (
            <article class="glass pcard" data-name={p.name.toLowerCase()}>
              <img src={p.img} alt={p.name} loading="lazy" />
              <div class="pbody">
                <h3>{p.name}{p.visible ? <span class="badge live">LIVE</span> : <span class="badge hid">HIDDEN</span>}</h3>
                <p class="pmeta">{'$' + p.price.toFixed(2)}{p.oldPrice ? ' · was $' + p.oldPrice.toFixed(2) : ''} · ★ {p.rating} · {p.sold || '—'}</p>
                <div class="pactions">
                  <a class="btn-dark" href={p.url} target="_blank" rel="sponsored nofollow noopener" style="text-decoration:none">Approve · View</a>
                  <a class="btn-ghost" href="/store/" style="text-decoration:none">In store</a>
                </div>
              </div>
            </article>
          ))}
        </div>
        <p class="chart-note" id="catNote">Showing all {vis.length + hidden.length} products. “Approve · View” opens the product's live AliExpress listing in a new tab — nothing on this page changes the store by itself.</p>
      </section>

      <section id="announcements" style="margin-bottom:1.1rem" aria-label="Announcements">
        <h2 style="font-size:1.15rem;margin:0 0 .8rem">📣 Announcements</h2>
        {announcements.map(a => (
          <article class="glass ann light">
            <div class="ahead"><span class="tag">{a.tag}</span><span class="when">{a.when}</span></div>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </article>
        ))}
      </section>

      <section class="glass card" id="activity" aria-label="Admin activity">
        <h2><i>🧾</i> Admin Activity Log</h2>
        <div class="tblwrap"><table id="logTable"><tr><th>Time (UTC)</th><th>Actor</th><th>Action</th><th>Detail</th><th>Result</th></tr><tr><td colspan="5"><span class="unavail">NOT CONNECTED</span></td></tr></table></div>
        <p>Once the Access lock is configured, login sessions and every dashboard action are recorded here from the D1 database (Cloudflare's own Access log, in the Zero Trust dashboard, keeps only 24 hours on the free plan — this D1 log is the durable record). In the current no-lock mode, no sessions are recorded.</p>
      </section>
    </main>
  </div>

  <div id="toast" role="status" aria-live="polite"></div>
  <script is:inline>
    (function(){
      function el(id){ return document.getElementById(id); }
      var D = null;
      function toast(msg){
        var t = el('toast'); if (!t) return;
        t.textContent = msg; t.className = 'show';
        setTimeout(function(){ t.className = ''; }, 2600);
      }
      function esc(s){ return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;'); }
      function notConnected(){
        el('whoami').textContent = 'Database not connected yet';
        el('clicks7').innerHTML = '<span class="unavail">NOT CONNECTED</span>';
        el('clicks30').innerHTML = '<span class="unavail">NOT CONNECTED</span>';
        el('earnTotal').innerHTML = '<span class="unavail">NOT CONNECTED</span>';
      }
      fetch('/api/admin/overview', { headers: { 'Accept': 'application/json' } }).then(function(r){
        if (!r.ok) throw new Error('http ' + r.status);
        return r.json();
      }).then(function(d){
        if (!d || !d.connected) { notConnected(); return; }
        D = d;
        el('whoami').textContent = d.email || 'owner';
        el('lastSync').textContent = d.lastSync || 'never';
        el('clicks7').textContent = d.clicks7d;
        el('clicks30').textContent = d.clicks30d;
        if (d.topProducts && d.topProducts.length) {
          el('topTable').innerHTML = '<tr><th>Product</th><th>Clicks (30d)</th></tr>' + d.topProducts.map(function(t){ return '<tr><td>' + esc(t.product) + '</td><td class="mono">' + esc(t.clicks) + '</td></tr>'; }).join('');
        } else {
          el('topTable').innerHTML = '<tr><th>Product</th><th>Clicks (30d)</th></tr><tr><td colspan="2">No clicks recorded yet.</td></tr>';
        }
        if (d.earnings) {
          el('earnTotal').textContent = '$' + (+d.earnings.total).toFixed(2);
          el('earnRows').textContent = d.earnings.rows;
          el('earnRowsCard').textContent = d.earnings.rows;
          el('earnLast').textContent = d.earnings.lastImport || 'never';
          var earnPct = Math.max(0, Math.min(100, (+d.earnings.total) / 100 * 100));
          el('ringEarn').setAttribute('stroke-dasharray', earnPct + ' 100');
          el('ringEarnPct').textContent = Math.round(earnPct) + '%';
          el('earnGoalVal').textContent = '$' + (+d.earnings.total).toFixed(2);
        }
        var clicksPct = Math.max(0, Math.min(100, (d.clicks30d || 0) / 1000 * 100));
        el('ringClicks').setAttribute('stroke-dasharray', clicksPct + ' 100');
        el('ringClicksPct').textContent = Math.round(clicksPct) + '%';
        el('clicksGoalVal').textContent = d.clicks30d || 0;
        (function(){
          var byDate = {};
          (d.dailySeries || []).forEach(function(r){ byDate[r.date] = +r.clicks || 0; });
          var days = [], max = 0, total30 = 0;
          for (var i = 29; i >= 0; i--) {
            var dt = new Date(Date.now() - i * 86400000);
            var key = dt.toISOString().slice(0, 10);
            var v = byDate[key] || 0;
            days.push({ key: key, v: v });
            if (v > max) max = v;
            total30 += v;
          }
          var periods = [];
          for (var g = 0; g < 6; g++) {
            var slice = days.slice(g * 5, g * 5 + 5);
            var sum = slice.reduce(function(a, x){ return a + x.v; }, 0);
            periods.push({ from: slice[0].key, to: slice[slice.length - 1].key, v: sum });
          }
          var pmax = periods.reduce(function(a, p){ return Math.max(a, p.v); }, 0);
          el('bars').innerHTML = periods.map(function(p){
            var h = p.v > 0 ? Math.max(8, Math.round(p.v / (pmax || 1) * 100)) : 3;
            return '<div class="bar' + (p.v > 0 ? '' : ' zero') + '" data-h="' + h + '" style="height:3%" title="' + p.from + ' to ' + p.to + ' — ' + p.v + ' clicks"></div>';
          }).join('');
          requestAnimationFrame(function(){ requestAnimationFrame(function(){
            var barsEl = el('bars'); if (!barsEl) return;
            barsEl.querySelectorAll('.bar').forEach(function(b){ b.style.height = b.getAttribute('data-h') + '%'; });
          }); });
          el('barsNote').textContent = total30 > 0 ? 'Total: ' + total30 + ' clicks in the last 30 days — each bar covers 5 days (hover for its dates).' : 'No clicks in the last 30 days yet — the six period bars fill in after the first GA4 sync.';
        })();
        (function(){
          var tops = d.topProducts || [];
          var total = tops.reduce(function(a, t){ return a + (+t.clicks || 0); }, 0);
          var palette = ['#d9a441', '#4f8cff', '#38b2ac', '#8b5cf6', '#e2603f', '#7fb069', '#c65b8f', '#5b8e7d', '#b97f16', '#64748b'];
          if (total > 0) {
            var off = 25, segs = '', legend = '';
            tops.forEach(function(t, idx){
              var share = (+t.clicks || 0) / total * 100;
              segs += '<circle cx="60" cy="60" r="46" fill="none" stroke="' + palette[idx % palette.length] + '" stroke-width="16" pathLength="100" stroke-dasharray="0 100" stroke-dashoffset="25" data-da="' + share.toFixed(2) + ' ' + (100 - share).toFixed(2) + '" data-do="' + off + '"></circle>';
              off -= share;
              legend += '<li><span class="sw" style="background:' + palette[idx % palette.length] + '"></span>' + esc(t.product) + ' — ' + Math.round(share) + '%</li>';
            });
            el('donutSegs').innerHTML = segs;
            requestAnimationFrame(function(){ requestAnimationFrame(function(){
              var ds = el('donutSegs'); if (!ds) return;
              ds.querySelectorAll('circle').forEach(function(c){
                c.setAttribute('stroke-dasharray', c.getAttribute('data-da'));
                c.setAttribute('stroke-dashoffset', c.getAttribute('data-do'));
              });
            }); });
            el('donutLegend').innerHTML = legend;
            el('donutTotal').textContent = total;
            el('donutNote').textContent = 'Share of clicks across the top products above (30 days).';
          }
        })();
        if (d.log && d.log.length) {
          el('logTable').innerHTML = '<tr><th>Time (UTC)</th><th>Actor</th><th>Action</th><th>Detail</th><th>Result</th></tr>' + d.log.map(function(l){ return '<tr><td class="mono">' + esc(l.ts) + '</td><td>' + esc(l.actor) + '</td><td>' + esc(l.action) + '</td><td>' + esc(l.detail) + '</td><td>' + esc(l.result) + '</td></tr>'; }).join('');
        } else {
          el('logTable').innerHTML = '<tr><th>Time (UTC)</th><th>Actor</th><th>Action</th><th>Detail</th><th>Result</th></tr><tr><td colspan="5">No activity recorded yet.</td></tr>';
        }
        if (d.topProducts && d.topProducts.length) {
          el('railTop').innerHTML = d.topProducts.slice(0, 5).map(function(t){ return '<div class="minirow"><span class="n">' + esc(t.product) + '</span><span class="c">' + esc(t.clicks) + '</span></div>'; }).join('');
        }
        if (d.log && d.log.length) {
          el('railLog').innerHTML = d.log.slice(0, 5).map(function(l){ return '<div class="minirow"><span class="n">' + esc(l.action) + (l.detail ? ' — ' + esc(l.detail) : '') + '</span><span class="c">' + esc(l.result) + '</span></div>'; }).join('');
        }
      }).catch(function(){ notConnected(); });

      // Animate the static catalogue-share ring on load (0 -> final sweep).
      (function(){
        var gauges = document.querySelectorAll('.gauges .gauge');
        var last = gauges[gauges.length - 1];
        if (!last) return;
        var c = last.querySelector('svg circle:nth-child(2)');
        if (!c) return;
        var finalDa = c.getAttribute('stroke-dasharray');
        if (!finalDa) return;
        c.setAttribute('stroke-dasharray', '0 100');
        requestAnimationFrame(function(){ requestAnimationFrame(function(){ c.setAttribute('stroke-dasharray', finalDa); }); });
      })();

      var themeBtn = el('themeToggle');
      function paintThemeBtn(){
        if (!themeBtn) return;
        themeBtn.textContent = document.documentElement.dataset.theme === 'day' ? '☀️ Day' : '🌙 Night';
      }
      if (themeBtn) {
        paintThemeBtn();
        themeBtn.addEventListener('click', function(){
          var next = document.documentElement.dataset.theme === 'day' ? 'night' : 'day';
          if (next === 'night') {
            if (document.documentElement.dataset.style === 'glass') {
              document.documentElement.dataset.theme = 'night';
              try { localStorage.setItem('irfan-dash-style', 'glass'); } catch (e) {}
            } else {
              delete document.documentElement.dataset.style;
              try { localStorage.setItem('irfan-dash-style', 'current'); } catch (e) {}
              document.documentElement.dataset.theme = 'night';
            }
          } else {
            try { localStorage.removeItem('irfan-dash-style'); } catch (e) {}
            document.documentElement.dataset.theme = 'day';
          }
          try { localStorage.setItem('irfan-dash-theme', next); } catch (e) {}
          paintThemeBtn();
          paintStyleBar();
        });
      }

      var bShare = el('btnShare');
      if (bShare) bShare.addEventListener('click', function(){
        var url = location.origin + '/irfan-admin/';
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(function(){ toast('Dashboard link copied: ' + url); }, function(){ toast(url); });
        } else { toast(url); }
      });
      var bExport = el('btnExport');
      if (bExport) bExport.addEventListener('click', function(){
        if (!D) { toast('Data has not loaded yet — wait a moment and retry.'); return; }
        var lines = [
          'IRFAN-GD Business Dashboard — summary',
          'Exported: ' + new Date().toLocaleString(),
          'Mode: ' + (D.email || 'public') + ' · Last GA4 sync: ' + (D.lastSync || 'never'),
          'Affiliate clicks (7 days): ' + D.clicks7d,
          'Affiliate clicks (30 days): ' + D.clicks30d,
          'Imported earnings: $' + (+D.earnings.total).toFixed(2) + ' across ' + D.earnings.rows + ' report rows',
          '',
          'Top products (30 days):'
        ];
        (D.topProducts || []).forEach(function(t){ lines.push('- ' + t.product + ': ' + t.clicks + ' clicks'); });
        if (!D.topProducts || !D.topProducts.length) lines.push('- none recorded yet');
        var blob = new Blob([lines.join('\n')], { type: 'text/plain' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'irfan-gd-dashboard-summary.txt';
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function(){ URL.revokeObjectURL(a.href); }, 4000);
        toast('Summary downloaded — only real figures, as shown on this page.');
      });
      var bPrint = el('btnPrint');
      if (bPrint) bPrint.addEventListener('click', function(){ window.print(); });
      var bDensity = el('btnDensity');
      if (bDensity) bDensity.addEventListener('click', function(){
        var on = document.body.classList.toggle('compact');
        try { localStorage.setItem('irfan-dash-density', on ? 'compact' : 'normal'); } catch (e) {}
        bDensity.textContent = on ? '🗜️ Normal view' : '🗜️ Compact view';
        toast(on ? 'Compact view on — cards are tighter.' : 'Normal view restored.');
      });
      try { if (localStorage.getItem('irfan-dash-density') === 'compact') { document.body.classList.add('compact'); if (bDensity) bDensity.textContent = '🗜️ Normal view'; } } catch (e) {}
      var bRefresh = el('btnRefresh');
      if (bRefresh) bRefresh.addEventListener('click', function(){ toast('Refreshing — reloading the latest figures…'); setTimeout(function(){ location.reload(); }, 500); });

      var DAY_STYLES = ['sequoia', 'sonoma', 'ventura', 'catalina', 'mojave', 'bigsur', 'glass'];
      function paintStyleBar(){
        var cur = document.documentElement.dataset.style || 'current';
        document.querySelectorAll('[data-style-pick]').forEach(function(b){
          b.classList.toggle('on', b.getAttribute('data-style-pick') === cur);
        });
      }
      document.querySelectorAll('[data-style-pick]').forEach(function(b){
        b.addEventListener('click', function(){
          var pick = b.getAttribute('data-style-pick');
          if (pick === 'current') {
            delete document.documentElement.dataset.style;
            try { localStorage.setItem('irfan-dash-style', 'current'); } catch (e) {}
            document.documentElement.dataset.theme = 'night';
            try { localStorage.setItem('irfan-dash-theme', 'night'); } catch (e) {}
          } else {
            document.documentElement.dataset.style = pick;
            document.documentElement.dataset.theme = DAY_STYLES.indexOf(pick) >= 0 ? 'day' : 'night';
            try { localStorage.setItem('irfan-dash-style', pick); } catch (e) {}
          }
          paintThemeBtn();
          paintStyleBar();
          toast('Style: ' + b.textContent.trim() + ' — ye pasand ab yaad rahegi.');
        });
      });
      paintStyleBar();

      var searchEl = el('dashSearch');
      if (searchEl) {
        searchEl.addEventListener('input', function(){
          var q = searchEl.value.trim().toLowerCase();
          var shown = 0;
          document.querySelectorAll('.pcard').forEach(function(c){
            var hit = !q || (c.getAttribute('data-name') || '').indexOf(q) !== -1;
            c.style.display = hit ? '' : 'none';
            if (hit) shown++;
          });
          var note = el('catNote');
          if (note) note.textContent = q ? shown + ' product(s) match your search.' : 'Showing all products.';
        });
      }

      el('syncBtn').addEventListener('click', function(){
        var btn = el('syncBtn'), msg = el('syncMsg');
        btn.disabled = true; msg.textContent = 'Syncing…'; msg.className = '';
        fetch('/api/admin/sync', { method: 'POST', headers: { 'Accept': 'application/json' } }).then(function(r){ return r.json().then(function(j){ return { ok: r.ok, j: j }; }); }).then(function(res){
          if (res.ok && res.j && res.j.ok) { msg.textContent = '✓ Synced at ' + (res.j.syncedAt || ''); msg.className = 'ok'; setTimeout(function(){ location.reload(); }, 900); }
          else { msg.textContent = '✗ ' + ((res.j && res.j.error) || 'Sync unavailable until backend is connected.'); msg.className = 'err'; }
        }).catch(function(){ msg.textContent = '✗ Sync unavailable until backend is connected.'; msg.className = 'err'; }).finally(function(){ btn.disabled = false; });
      });

      el('importForm').addEventListener('submit', function(ev){
        ev.preventDefault();
        var btn = el('importBtn'), msg = el('importMsg'), f = el('csvFile').files[0];
        if (!f) return;
        if (f.size > 2 * 1024 * 1024) { msg.textContent = '✗ File is larger than 2 MB.'; msg.className = 'err'; return; }
        if (!/\.csv$/i.test(f.name)) { msg.textContent = '✗ Only .csv files are accepted.'; msg.className = 'err'; return; }
        btn.disabled = true; msg.textContent = 'Validating & importing…'; msg.className = '';
        var fd = new FormData(); fd.append('file', f);
        fetch('/api/admin/import', { method: 'POST', body: fd, headers: { 'Accept': 'application/json' } }).then(function(r){ return r.json().then(function(j){ return { ok: r.ok, j: j }; }); }).then(function(res){
          if (res.ok && res.j && res.j.ok) { msg.textContent = '✓ Imported ' + res.j.imported + ' rows (' + res.j.skippedDuplicates + ' duplicates skipped).'; msg.className = 'ok'; setTimeout(function(){ location.reload(); }, 1200); }
          else { msg.textContent = '✗ ' + ((res.j && res.j.error) || 'Import unavailable until backend is connected.'); msg.className = 'err'; }
        }).catch(function(){ msg.textContent = '✗ Import unavailable until backend is connected.'; msg.className = 'err'; }).finally(function(){ btn.disabled = false; });
      });
    })();
  </script>
</body>
</html>
