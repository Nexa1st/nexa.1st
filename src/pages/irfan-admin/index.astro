---
import store from '../../data/store.json';
const nowPkt = new Date(Date.now() + 5 * 3600 * 1000);
const hourPkt = nowPkt.getUTCHours();
const greetWord = hourPkt < 12 ? 'Good morning' : hourPkt < 17 ? 'Good afternoon' : 'Good evening';
const dateLine = nowPkt.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const day30 = 86400000;
const fmtDay = (t: number) => new Date(t).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const announcements = [
  { tag: 'SYNC', when: 'Daily · 11:00 AM PKT', title: 'GA4 clicks sync runs automatically every day', body: 'The irfan-ga4-sync Worker pulls the last 30 days of affiliate_click events from Google Analytics into this dashboard. No manual step is needed once it is active.' },
  { tag: 'STORE', when: 'Mondays · ~11:44 AM PKT', title: 'Weekly store refresh prepares new product candidates', body: 'New AliExpress electronics are verified (price, rating, sold count on the real listing) and proposed here — nothing is added or hidden without the owner\'s approval tap.' },
  { tag: 'ADS', when: 'Live since 2026-11-11', title: 'Adsterra ads are live on the site (Banner + Native only)', body: 'Consent-gated, no popunder, no social bar. Six restricted advertiser categories were authorized for account-wide unlinking; written confirmation that the restrictions are ACTIVE is still awaited.' },
  { tag: 'SEO', when: 'Checked daily', title: 'Google indexing is monitored every day', body: 'Homepage is indexed in Search Console; the 8 articles are being pushed for indexing and the sitemap state is re-checked daily.' },
];
const vis = (store.products as any[]).filter(p => p.visible);
const hidden = (store.products as any[]).filter(p => !p.visible);
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>IRFAN-GD Business Dashboard</title>
  <meta name="robots" content="noindex, nofollow" />
  <meta name="description" content="IRFAN-GD business dashboard: affiliate clicks, top-performing products and earnings imported from official AliExpress Portals reports." />
  <link rel="icon" type="image/webp" href="/store/avatar.webp" />
  <script is:inline>try{var q=new URLSearchParams(location.search);var st=q.get('style');var th=q.get('theme');var savedStyle=localStorage.getItem('irfan-dash-style');var savedTheme=localStorage.getItem('irfan-dash-theme');var DAY=['sequoia','sonoma','ventura','catalina','mojave','bigsur','glass'];function themeFor(s){if(DAY.indexOf(s)>=0){return (s==='glass'&&(th?th==='night':savedTheme==='night'))?'night':'day';}return 'night';}if(st){if(st==='current'){document.documentElement.dataset.theme=(savedTheme||'night');}else{document.documentElement.dataset.style=st;document.documentElement.dataset.theme=themeFor(st);}}else if(savedStyle){if(savedStyle==='current'){document.documentElement.dataset.theme=(savedTheme||'night');}else{document.documentElement.dataset.style=savedStyle;document.documentElement.dataset.theme=themeFor(savedStyle);}}else if(th){document.documentElement.dataset.style='glass';document.documentElement.dataset.theme=th;}else{document.documentElement.dataset.style='glass';document.documentElement.dataset.theme=(savedTheme==='night'?'night':'day');}}catch(e){}</script>
  <style>
    :root{
      --bg:#0a3442; --panel:rgba(16,52,66,.55); --panel2:rgba(23,68,84,.42);
      --stroke:rgba(160,225,245,.20); --stroke2:rgba(160,225,245,.36);
      --txt:#f2fbff; --dim:#a9cbda; --dim2:#7ba3b5;
      --gold:#D4AF37; --gold2:#FFD700; --cyan:#38e1ff; --blue:#4f8cff; --violet:#8b5cf6;
      --green:#34d399; --amber:#f0b429; --red:#ff8a8a;
    }
    *{box-sizing:border-box}
    html,body{margin:0;padding:0;overflow-x:clip}
    body{
      color:var(--txt); line-height:1.55; min-height:100vh;
      font-family:ui-sans-system,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
      background:
        radial-gradient(1100px 620px at 88% -12%, rgba(56,225,255,.20), transparent 60%),
        radial-gradient(900px 720px at -12% 22%, rgba(45,140,170,.30), transparent 58%),
        radial-gradient(850px 650px at 55% 118%, rgba(20,90,120,.35), transparent 60%),
        linear-gradient(155deg,#12566b 0%, #0a3442 55%, #06222e 100%);
      background-attachment:fixed;
    }
    /* ---------- shell ---------- */
    .shell{display:grid;grid-template-columns:224px 1fr;min-height:100vh}
    .side{
      position:sticky;top:0;height:100vh;padding:1.1rem .9rem;
      background:linear-gradient(180deg,rgba(10,44,58,.82),rgba(8,34,46,.72));
      border-right:1px solid var(--stroke);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
      display:flex;flex-direction:column;gap:1.1rem;
    }
    .brand{display:flex;align-items:center;gap:.65rem;padding:.2rem .35rem}
    .brand img{width:40px;height:40px;border-radius:12px;border:1px solid var(--stroke2);object-fit:cover}
    .brand b{font-size:.98rem;letter-spacing:.04em;display:block;line-height:1.15}
    .brand span{font-size:.7rem;color:var(--dim2);letter-spacing:.14em;text-transform:uppercase}
    .nav{display:flex;flex-direction:column;gap:.25rem}
    .nav a{
      display:flex;align-items:center;gap:.6rem;padding:.55rem .65rem;border-radius:11px;
      color:var(--dim);text-decoration:none;font-size:.9rem;border:1px solid transparent;
    }
    .nav a i{font-style:normal;width:1.15rem;text-align:center;opacity:.9}
    .nav a.on{color:#fff;background:linear-gradient(120deg,rgba(56,225,255,.26),rgba(56,225,255,.10));border-color:var(--stroke)}
    .nav a:hover{color:#fff;border-color:var(--stroke)}
    .side .foot{margin-top:auto;font-size:.72rem;color:var(--dim2);padding:0 .35rem}
    .side .foot a{color:var(--gold2);text-decoration:none}
    /* ---------- main ---------- */
    .main{padding:1.3rem 1.4rem 3rem;min-width:0}
    .topbar{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.1rem}
    .topbar h1{font-size:1.55rem;margin:0;letter-spacing:.01em}
    .topbar .sub{color:var(--dim);font-size:.9rem;margin-top:.15rem}
    .chiprow{display:flex;gap:.5rem;flex-wrap:wrap}
    .chip{
      display:inline-flex;align-items:center;gap:.45rem;padding:.42rem .75rem;border-radius:999px;
      background:var(--panel);border:1px solid var(--stroke);font-size:.8rem;color:var(--dim);
      backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    }
    .chip b{color:#fff;font-weight:700}
    .dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 10px var(--green)}
    /* ---------- glass cards ---------- */
    .glass{
      background:linear-gradient(155deg,var(--panel),var(--panel2));
      border:1px solid var(--stroke);border-radius:20px;
      backdrop-filter:blur(22px) saturate(160%);-webkit-backdrop-filter:blur(22px) saturate(160%);
      box-shadow:0 18px 40px rgba(0,10,16,.45), inset 0 1px 0 rgba(255,255,255,.10);
    }
    .notice{padding:1rem 1.15rem;margin-bottom:1.1rem}
    .notice strong{color:var(--gold2);letter-spacing:.02em}
    .notice p{margin:.35rem 0 0;color:var(--dim);font-size:.9rem}
    .notice code{background:rgba(255,255,255,.08);border:1px solid var(--stroke);border-radius:6px;padding:.05rem .35rem;font-size:.85em;color:#d8f2ff}
    .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,215px),1fr));gap:.95rem;margin-bottom:1.1rem}
    .stat{padding:1.05rem 1.1rem;position:relative;overflow:hidden;transition:transform .25s ease, border-color .25s ease}
    .stat:hover{transform:translateY(-4px);border-color:var(--stroke2)}
    .stat::before{content:"";position:absolute;inset:0 0 auto 0;height:4px;border-radius:4px 4px 0 0;background:var(--acc,var(--blue));opacity:1}
    .stat .lbl{font-size:.78rem;color:var(--dim);letter-spacing:.09em;text-transform:uppercase;display:flex;justify-content:space-between;align-items:center}
    .stat .lbl i{font-style:normal;font-size:1rem;opacity:.85}
    .stat .val{font-size:1.9rem;font-weight:800;letter-spacing:.01em;line-height:1.12;margin-top:.3rem;font-variant-numeric:tabular-nums}
    .stat .hint{font-size:.78rem;color:var(--dim2);margin-top:.15rem}
    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:1.1rem;margin-bottom:1.1rem}
    .card{padding:1.15rem 1.2rem}
    .card h2{font-size:1.02rem;margin:0 0 .7rem;color:var(--txt);letter-spacing:.03em;display:flex;align-items:center;gap:.5rem}
    .card h2 i{font-style:normal}
    .card p{color:var(--dim);font-size:.9rem}
    table{width:100%;border-collapse:collapse;font-size:.9rem}
    td, th{padding:.5rem .5rem;border-bottom:1px solid rgba(160,225,245,.12);text-align:left;color:#e2f2fa}
    th{color:var(--dim);font-weight:600;font-size:.78rem;letter-spacing:.07em;text-transform:uppercase}
    tr:last-child td{border-bottom:0}
    .unavail{color:var(--amber);font-weight:800;letter-spacing:.04em}
    button{
      background:linear-gradient(92deg,var(--gold),var(--gold2));color:#171106;border:0;border-radius:11px;
      padding:.55rem 1.05rem;font-weight:800;cursor:pointer;font:inherit;font-size:.9rem;
      box-shadow:0 6px 18px rgba(212,175,55,.25);
    }
    button:hover{filter:brightness(1.06)}
    button[disabled]{opacity:.5;cursor:wait}
    input[type=file]{color:#d6ecf5;font:inherit;font-size:.9rem}
    .ok{color:var(--green);font-weight:700}.err{color:var(--red);font-weight:700}
    .mono{font-variant-numeric:tabular-nums}
    a{color:var(--gold2)}
    .qa{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.75rem}
    .qa a,.qa button{padding:.48rem .85rem;border-radius:999px;border:1px solid var(--stroke2);background:var(--panel);color:var(--txt);text-decoration:none;font-size:.83rem;font-weight:700;box-shadow:none;backdrop-filter:blur(10px)}
    .layout{display:grid;grid-template-columns:1fr 300px;gap:1.1rem;align-items:start}
    .col-main{min-width:0}
    .col-rail{display:flex;flex-direction:column;gap:1.1rem;position:sticky;top:1.1rem}
    .searchbar{display:flex;align-items:center;gap:.7rem;margin-bottom:1.1rem;padding:.5rem .6rem .5rem 1rem}
    .searchbar .mag{opacity:.75}
    .searchbar input{flex:1;min-width:0;background:transparent;border:0;outline:0;color:var(--txt);font:inherit;font-size:.95rem}
    .searchbar input::placeholder{color:var(--dim2)}
    .avatar{width:38px;height:38px;border-radius:50%;border:2px solid var(--stroke2);object-fit:cover;flex:none}
    .pcards{display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:1rem}
    .pcard{overflow:hidden;padding:0}
    .pcard img{width:100%;height:128px;object-fit:cover;display:block}
    .pcard .pbody{padding:.8rem .9rem .95rem}
    .pcard h3{font-size:.93rem;margin:0 0 .25rem;line-height:1.35}
    .pcard .pmeta{font-size:.8rem;color:var(--dim)}
    .pcard .pactions{display:flex;gap:.5rem;margin-top:.7rem}
    .btn-dark{background:#0b1116;color:#fff;border:0;border-radius:9px;padding:.5rem .95rem;font-weight:700;cursor:pointer;font:inherit;font-size:.85rem;box-shadow:none}
    .btn-dark:hover{filter:brightness(1.25)}
    .btn-ghost{background:rgba(255,255,255,.10);color:var(--txt);border:1px solid var(--stroke);border-radius:9px;padding:.5rem .8rem;font-weight:700;font:inherit;font-size:.85rem;box-shadow:none}
    .badge{display:inline-block;font-size:.7rem;font-weight:800;letter-spacing:.05em;padding:.14rem .5rem;border-radius:999px;margin-left:.4rem;vertical-align:middle}
    .badge.live{background:rgba(52,211,153,.20);color:#7bf0c4;border:1px solid rgba(52,211,153,.4)}
    .badge.hid{background:rgba(240,180,41,.16);color:#ffd97a;border:1px solid rgba(240,180,41,.4)}
    .minirow{display:flex;gap:.6rem;padding:.55rem 0;border-bottom:1px solid rgba(160,225,245,.10);font-size:.87rem}
    .minirow:last-child{border-bottom:0}
    .minirow .n{flex:1;min-width:0}
    .minirow .c{font-weight:800;font-variant-numeric:tabular-nums}
    @media (max-width:1180px){ .layout{grid-template-columns:1fr} .col-rail{position:static} }
    .qa a:hover{border-color:var(--gold)}
    .glass.light{background:linear-gradient(150deg,rgba(235,248,252,.88),rgba(205,232,242,.78));color:#17323f;border-color:rgba(255,255,255,.55);box-shadow:0 14px 30px rgba(0,10,16,.30), inset 0 1px 0 rgba(255,255,255,.8)}
    .glass.light h2,.glass.light h3{color:#17323f}
    .glass.light p,.glass.light .pmeta{color:#40606f}
    .glass.light .chart-note{color:#5d7f8f}
    .tabs{display:flex;gap:.45rem;flex-wrap:wrap;margin:0 0 1.1rem}
    .tabs a{padding:.5rem 1rem;border-radius:999px;background:rgba(235,248,252,.20);border:1px solid var(--stroke);color:var(--dim);text-decoration:none;font-size:.86rem;font-weight:700;backdrop-filter:blur(10px)}
    .tabs a.on{background:#0b1116;color:#fff;border-color:#0b1116}
    .tabs a:hover{color:#fff;border-color:var(--stroke2)}
    .tabs a.on:hover{color:#fff}
    .stat.light .lbl{color:#40606f}
    .stat.light .hint{color:#5d7f8f}
    .ann{padding:1rem 1.1rem;margin-bottom:.8rem}
    .ann:last-child{margin-bottom:0}
    .ann .ahead{display:flex;gap:.6rem;align-items:center;flex-wrap:wrap}
    .ann .tag{font-size:.68rem;font-weight:800;letter-spacing:.08em;background:#0b1116;color:#fff;border-radius:999px;padding:.18rem .55rem}
    .ann .when{font-size:.76rem;color:#5d7f8f}
    .ann h3{font-size:.98rem;margin:.45rem 0 .25rem}
    .ann p{font-size:.88rem;margin:0}
    .bigbars{display:flex;align-items:flex-end;gap:10px;height:150px;margin-top:.5rem}
    .bigbars .bar{flex:1;border-radius:8px 8px 3px 3px;background:linear-gradient(180deg,#7fd8ef,#2b9dbd);min-height:4px}
    .bigbars .bar.zero{background:rgba(23,50,63,.14)}
    .qa button.off{opacity:.55;cursor:not-allowed}
    .bars{display:flex;align-items:flex-end;gap:3px;height:120px;margin-top:.35rem}
    .bars .bar{flex:1;min-width:3px;border-radius:4px 4px 2px 2px;background:linear-gradient(180deg,#eec25e,#bd8524)}
    .bars .bar.zero{background:rgba(160,225,245,.16)}
    .bars .bar:hover{filter:brightness(1.13)}
    .chart-note{font-size:.8rem;color:var(--dim2);margin-top:.6rem}
    .donut-wrap{display:flex;gap:1.15rem;align-items:center;flex-wrap:wrap}
    .legend{list-style:none;margin:0;padding:0;font-size:.85rem;color:var(--dim)}
    .legend li{display:flex;gap:.5rem;align-items:center;margin:.28rem 0}
    .legend .sw{width:11px;height:11px;border-radius:3px;display:inline-block;flex:none}
    .gauges{display:flex;gap:1.8rem;flex-wrap:wrap;align-items:flex-start}
    .gauge{text-align:center;min-width:118px}
    .gauge .gv{font-weight:800;font-size:1.02rem;margin-top:.35rem}
    .gauge .gl{font-size:.74rem;color:var(--dim);letter-spacing:.07em;text-transform:uppercase;margin-top:.1rem}
    @media (max-width:900px){ .grid2{grid-template-columns:1fr} }
    @media (max-width:760px){
      .shell{grid-template-columns:1fr}
      .side{position:static;height:auto;flex-direction:row;align-items:center;flex-wrap:wrap;padding:.8rem;gap:.7rem}
      .brand{flex:1 1 100%}
      .nav{flex-direction:row;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;flex:1 1 100%;padding-bottom:.15rem}
      .nav::-webkit-scrollbar{display:none}
      .nav .grp{display:none}
      .nav a{padding:.45rem .55rem;flex:none}
      .plan{flex:1 1 100%;margin-top:.2rem}
      .side .foot{display:none}
      .main{padding:1rem .9rem 2.4rem}
      .topbar h1{font-size:1.3rem}
      .gauges{justify-content:center}
    }
    @media (max-width:480px){
      .main{padding:.85rem .75rem 2rem}
      .topbar h1{font-size:1.2rem}
      .card{padding:1rem}
      .stat .val{font-size:1.7rem}
      .feat button{padding:.5rem .8rem;font-size:.82rem}
      .stylebar button{padding:.38rem .6rem;font-size:.78rem}
      .searchbar{padding:.45rem .5rem .45rem .85rem}
      .chip{padding:.36rem .6rem;font-size:.76rem}
    }
    .tblwrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
    @media (max-width:760px){ .tblwrap table{min-width:620px} }
    @media (prefers-reduced-motion:reduce){
      *,*::before,*::after{animation-duration:.01ms !important;animation-iteration-count:1 !important;animation-delay:0ms !important;transition-duration:.01ms !important;transition-delay:0ms !important}
      .stat{transition:none} .stat:hover{transform:none}
      .glass.card:hover,.pcard:hover,.ann:hover,button:hover{transform:none}
    }
    /* ---------- macOS Day theme ---------- */
    html[data-theme="day"]{
      --bg:#dfe9f2; --panel:rgba(255,255,255,.62); --panel2:rgba(246,250,253,.50);
      --stroke:rgba(31,60,86,.14); --stroke2:rgba(31,60,86,.26);
      --txt:#13222e; --dim:#476273; --dim2:#758d9c;
      --gold:#a87f14; --gold2:#8a6414; --green:#0f9d74; --amber:#b97f16; --red:#c24343;
    }
    html[data-theme="day"] body{
      background:
        radial-gradient(1000px 620px at 88% -12%, rgba(140,200,255,.45), transparent 60%),
        radial-gradient(900px 700px at -12% 22%, rgba(255,196,220,.35), transparent 58%),
        radial-gradient(850px 650px at 55% 118%, rgba(190,230,200,.40), transparent 60%),
        linear-gradient(155deg,#f4f8fb 0%, #dfe9f2 55%, #cfdde9 100%);
    }
    html[data-theme="day"] .side{background:linear-gradient(180deg,rgba(255,255,255,.72),rgba(240,246,250,.60))}
    html[data-theme="day"] .glass{box-shadow:0 16px 34px rgba(31,60,86,.16), inset 0 1px 0 rgba(255,255,255,.75)}
    html[data-theme="day"] .glass.light{background:linear-gradient(150deg,rgba(255,255,255,.92),rgba(238,246,250,.85));border-color:rgba(31,60,86,.10)}
    html[data-theme="day"] .nav a.on{color:#13222e;background:linear-gradient(120deg,rgba(56,150,255,.22),rgba(56,150,255,.10))}
    html[data-theme="day"] .nav a:hover{color:#13222e}
    html[data-theme="day"] .chip b{color:#13222e}
    html[data-theme="day"] td, html[data-theme="day"] th{border-bottom-color:rgba(31,60,86,.12);color:#22394a}
    html[data-theme="day"] .notice code{background:rgba(255,255,255,.6);color:#22394a}
    html[data-theme="day"] input[type=file]{color:#22394a}
    html[data-theme="day"] .minirow{border-bottom-color:rgba(31,60,86,.10)}
    html[data-theme="day"] .btn-ghost{background:rgba(255,255,255,.55)}
    html[data-theme="day"] .bars .bar.zero, html[data-theme="day"] .bigbars .bar.zero{background:rgba(31,60,86,.14)}
    .lights{display:flex;gap:8px;padding:.15rem .35rem 0}
    .lights i{width:12px;height:12px;border-radius:50%;display:block;box-shadow:inset 0 0 2px rgba(0,0,0,.25)}
    .lights .r{background:#ff5f57}.lights .y{background:#febc2e}.lights .g{background:#28c840}
    #themeToggle{margin-left:auto;flex:none;background:rgba(255,255,255,.14);border:1px solid var(--stroke2);color:var(--txt);border-radius:999px;padding:.45rem .8rem;font:inherit;font-size:.83rem;font-weight:700;cursor:pointer;box-shadow:none;backdrop-filter:blur(8px)}
    html[data-theme="day"] #themeToggle{background:rgba(255,255,255,.65)}
    /* ---------- V7 sidebar: grouped menu, badges, plan card ---------- */
    .nav .grp{font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;color:var(--dim2);margin:.85rem .45rem .3rem;font-weight:800}
    .nav .grp:first-child{margin-top:0}
    .nav a .cnt{margin-left:auto;font-size:.7rem;font-weight:800;background:rgba(255,255,255,.16);border:1px solid var(--stroke);border-radius:999px;padding:.05rem .5rem;font-variant-numeric:tabular-nums}
    html[data-theme="day"] .nav a .cnt{background:rgba(31,60,86,.08)}
    .nav a .chev{margin-left:auto;color:var(--dim2);font-size:.75rem}
    .nav a .cnt + .chev{margin-left:.4rem}
    .plan{margin-top:1rem;padding:.85rem .9rem;border-radius:16px;background:linear-gradient(150deg,rgba(255,255,255,.12),rgba(255,255,255,.05));border:1px solid var(--stroke)}
    html[data-theme="day"] .plan{background:linear-gradient(150deg,rgba(255,255,255,.75),rgba(240,246,250,.55))}
    .plan b{font-size:.86rem;display:block}
    .plan p{font-size:.74rem;color:var(--dim);margin:.3rem 0 .55rem}
    .plan .bar{height:6px;border-radius:99px;background:rgba(255,255,255,.18);overflow:hidden}
    html[data-theme="day"] .plan .bar{background:rgba(31,60,86,.12)}
    .plan .bar i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--gold),var(--gold2))}
    .feat{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1.1rem}
    .feat button{padding:.55rem 1rem;border-radius:999px;background:var(--panel);border:1px solid var(--stroke);color:var(--txt);font:inherit;font-size:.86rem;font-weight:700;cursor:pointer;box-shadow:none;backdrop-filter:blur(10px)}
    .feat button:hover{border-color:var(--stroke2);transform:translateY(-1px)}
    .feat button.warnb:hover{border-color:var(--amber)}
    #toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%) translateY(16px);background:#0b1116;color:#fff;padding:.7rem 1.1rem;border-radius:12px;font-size:.88rem;font-weight:600;opacity:0;pointer-events:none;transition:opacity .25s ease, transform .25s ease;z-index:60;box-shadow:0 14px 34px rgba(0,0,0,.4);max-width:92vw;text-align:center}
    #toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
    body.compact .card{padding:.85rem .95rem}
    body.compact .stat{padding:.8rem .9rem}
    body.compact .stat .val{font-size:1.5rem}
    body.compact .main{padding-top:.9rem}
