---
import store from '../../data/store.json';
const vis = (store.products as any[]).filter(p => p.visible);
const hidden = (store.products as any[]).filter(p => !p.visible);
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>IRFAN-GD Business Dashboard</title>
  <meta name="robots" content="noindex, nofollow" />
  <meta name="description" content="IRFAN-GD business dashboard: affiliate clicks, top-performing products and earnings imported from official AliExpress Portals reports." />
  <link rel="icon" type="image/webp" href="/store/avatar.webp" />
  <style>
    :root{
      --bg:#e7dcc4; --panel:rgba(255,252,246,.66); --panel2:rgba(255,246,230,.48);
      --stroke:rgba(122,90,40,.20); --stroke2:rgba(122,90,40,.34);
      --txt:#2a2013; --dim:#5f5040; --dim2:#8a7a63;
      --gold:#b98a1f; --gold2:#8a6414; --cyan:#1f7a8c; --blue:#4f8cff; --violet:#8b5cf6;
      --green:#1d9e75; --amber:#b97f16; --red:#c24343;
    }
    *{box-sizing:border-box}
    html,body{margin:0;padding:0;overflow-x:clip}
    body{
      color:var(--txt); line-height:1.55; min-height:100vh;
      font-family:ui-sans-system,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
      background:
        radial-gradient(1000px 620px at 88% -12%, rgba(255,214,150,.55), transparent 60%),
        radial-gradient(900px 700px at -12% 20%, rgba(255,255,255,.65), transparent 55%),
        radial-gradient(850px 650px at 55% 118%, rgba(196,138,62,.30), transparent 60%),
        linear-gradient(155deg,#f2e8d5 0%, #e7dcc4 52%, #d8c5a2 100%);
      background-attachment:fixed;
    }
    /* ---------- shell ---------- */
    .shell{display:grid;grid-template-columns:224px 1fr;min-height:100vh}
    .side{
      position:sticky;top:0;height:100vh;padding:1.1rem .9rem;
      background:linear-gradient(180deg,rgba(255,251,243,.78),rgba(250,240,222,.62));
      border-right:1px solid var(--stroke);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
      display:flex;flex-direction:column;gap:1.1rem;
    }
    .brand{display:flex;align-items:center;gap:.65rem;padding:.2rem .35rem}
    .brand img{width:40px;height:40px;border-radius:12px;border:1px solid var(--stroke2);object-fit:cover}
    .brand b{font-size:.98rem;letter-spacing:.04em;display:block;line-height:1.15}
    .brand span{font-size:.7rem;color:var(--dim2);letter-spacing:.14em;text-transform:uppercase}
    .nav{display:flex;flex-direction:column;gap:.25rem}
    .nav a{
      display:flex;align-items:center;gap:.6rem;padding:.55rem .65rem;border-radius:11px;
      color:var(--dim);text-decoration:none;font-size:.9rem;border:1px solid transparent;
    }
    .nav a i{font-style:normal;width:1.15rem;text-align:center;opacity:.9}
    .nav a.on{color:var(--txt);background:linear-gradient(120deg,rgba(217,164,65,.30),rgba(217,164,65,.14));border-color:var(--stroke)}
    .nav a:hover{color:var(--txt);border-color:var(--stroke)}
    .side .foot{margin-top:auto;font-size:.72rem;color:var(--dim2);padding:0 .35rem}
    .side .foot a{color:var(--gold2);text-decoration:none}
    /* ---------- main ---------- */
    .main{padding:1.3rem 1.4rem 3rem;min-width:0}
    .topbar{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.1rem}
    .topbar h1{font-size:1.55rem;margin:0;letter-spacing:.01em}
    .topbar .sub{color:var(--dim);font-size:.9rem;margin-top:.15rem}
    .chiprow{display:flex;gap:.5rem;flex-wrap:wrap}
    .chip{
      display:inline-flex;align-items:center;gap:.45rem;padding:.42rem .75rem;border-radius:999px;
      background:var(--panel);border:1px solid var(--stroke);font-size:.8rem;color:var(--dim);
      backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    }
    .chip b{color:var(--txt);font-weight:700}
    .dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 10px var(--green)}
    /* ---------- glass cards ---------- */
    .glass{
      background:linear-gradient(155deg,var(--panel),var(--panel2));
      border:1px solid var(--stroke);border-radius:20px;
      backdrop-filter:blur(18px) saturate(140%);-webkit-backdrop-filter:blur(18px) saturate(140%);
      box-shadow:0 18px 38px rgba(96,66,20,.22), inset 0 1px 0 rgba(255,255,255,.65);
    }
    .notice{padding:1rem 1.15rem;margin-bottom:1.1rem}
    .notice strong{color:var(--gold2);letter-spacing:.02em}
    .notice p{margin:.35rem 0 0;color:var(--dim);font-size:.9rem}
    .notice code{background:rgba(255,255,255,.5);border:1px solid var(--stroke);border-radius:6px;padding:.05rem .35rem;font-size:.85em;color:#4a3a20}
    .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,215px),1fr));gap:.95rem;margin-bottom:1.1rem}
    .stat{padding:1.05rem 1.1rem;position:relative;overflow:hidden;transition:transform .25s ease, border-color .25s ease}
    .stat:hover{transform:translateY(-4px);border-color:var(--stroke2)}
    .stat::before{content:"";position:absolute;inset:0 0 auto 0;height:3px;background:var(--acc,var(--blue));opacity:.85}
    .stat .lbl{font-size:.78rem;color:var(--dim);letter-spacing:.09em;text-transform:uppercase;display:flex;justify-content:space-between;align-items:center}
    .stat .lbl i{font-style:normal;font-size:1rem;opacity:.85}
    .stat .val{font-size:1.9rem;font-weight:800;letter-spacing:.01em;margin-top:.3rem;font-variant-numeric:tabular-nums}
    .stat .hint{font-size:.78rem;color:var(--dim2);margin-top:.15rem}
    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:1.1rem;margin-bottom:1.1rem}
    .card{padding:1.15rem 1.2rem}
    .card h2{font-size:1.02rem;margin:0 0 .7rem;color:var(--txt);letter-spacing:.03em;display:flex;align-items:center;gap:.5rem}
    .card h2 i{font-style:normal}
    .card p{color:var(--dim);font-size:.9rem}
    table{width:100%;border-collapse:collapse;font-size:.9rem}
    td, th{padding:.5rem .5rem;border-bottom:1px solid rgba(122,90,40,.14);text-align:left;color:#3a2f21}
    th{color:var(--dim);font-weight:600;font-size:.78rem;letter-spacing:.07em;text-transform:uppercase}
    tr:last-child td{border-bottom:0}
    .unavail{color:var(--amber);font-weight:800;letter-spacing:.04em}
    button{
      background:linear-gradient(92deg,var(--gold),var(--gold2));color:#171106;border:0;border-radius:11px;
      padding:.55rem 1.05rem;font-weight:800;cursor:pointer;font:inherit;font-size:.9rem;
      box-shadow:0 6px 18px rgba(212,175,55,.25);
    }
    button:hover{filter:brightness(1.06)}
    button[disabled]{opacity:.5;cursor:wait}
    input[type=file]{color:#3a2f21;font:inherit;font-size:.9rem}
    .ok{color:var(--green);font-weight:700}.err{color:var(--red);font-weight:700}
    .mono{font-variant-numeric:tabular-nums}
    a{color:var(--gold2)}
    .qa{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.75rem}
    .qa a,.qa button{padding:.48rem .85rem;border-radius:999px;border:1px solid var(--stroke2);background:var(--panel);color:var(--txt);text-decoration:none;font-size:.83rem;font-weight:700;box-shadow:none;backdrop-filter:blur(10px)}
    .qa a:hover{border-color:var(--gold)}
    .qa button.off{opacity:.55;cursor:not-allowed}
    .bars{display:flex;align-items:flex-end;gap:3px;height:120px;margin-top:.35rem}
    .bars .bar{flex:1;min-width:3px;border-radius:4px 4px 2px 2px;background:linear-gradient(180deg,#eec25e,#bd8524)}
    .bars .bar.zero{background:rgba(122,90,40,.18)}
    .bars .bar:hover{filter:brightness(1.13)}
    .chart-note{font-size:.8rem;color:var(--dim2);margin-top:.6rem}
    .donut-wrap{display:flex;gap:1.15rem;align-items:center;flex-wrap:wrap}
    .legend{list-style:none;margin:0;padding:0;font-size:.85rem;color:var(--dim)}
    .legend li{display:flex;gap:.5rem;align-items:center;margin:.28rem 0}
    .legend .sw{width:11px;height:11px;border-radius:3px;display:inline-block;flex:none}
    .gauges{display:flex;gap:1.8rem;flex-wrap:wrap;align-items:flex-start}
    .gauge{text-align:center;min-width:118px}
    .gauge .gv{font-weight:800;font-size:1.02rem;margin-top:.35rem}
    .gauge .gl{font-size:.74rem;color:var(--dim);letter-spacing:.07em;text-transform:uppercase;margin-top:.1rem}
    @media (max-width:900px){ .grid2{grid-template-columns:1fr} }
    @media (max-width:760px){
      .shell{grid-template-columns:1fr}
      .side{position:static;height:auto;flex-direction:row;align-items:center;flex-wrap:wrap;padding:.8rem}
      .nav{flex-direction:row;flex-wrap:wrap}
      .nav a{padding:.45rem .55rem}
      .side .foot{display:none}
      .main{padding:1rem .9rem 2.4rem}
      .topbar h1{font-size:1.3rem}
    }
    @media (prefers-reduced-motion:reduce){ .stat{transition:none} .stat:hover{transform:none} }
  </style>
</head>
<body>
  <div class="shell">
    <aside class="side">
      <div class="brand">
        <img src="/store/avatar.webp" alt="IRFAN-GD logo" width="40" height="40" />
        <div><b>IRFAN-GD</b><span>Admin V2</span></div>
      </div>
      <nav class="nav" aria-label="Dashboard">
        <a href="/irfan-admin/" class="on"><i>▦</i> Overview</a>
        <a href="/store/"><i>🛍️</i> Storefront</a>
        <a href="/store/"><i>🏷️</i> Products</a>
        <a href="/#tools"><i>🧰</i> Tools</a>
        <a href="/disclosure/"><i>📄</i> Disclosure</a>
      </nav>
      <p class="foot">Affiliate showcase — sales happen on AliExpress.<br /><a href="/store/">← Back to the store</a></p>
    </aside>

    <main class="main">
      <div class="topbar">
        <div>
          <h1>Business Dashboard</h1>
          <p class="sub">Affiliate clicks, top products &amp; imported earnings — real figures only.</p>
        </div>
        <div class="chiprow">
          <span class="chip"><span class="dot"></span> Mode: <b id="whoami">checking…</b></span>
          <span class="chip">Last GA4 sync: <b id="lastSync">—</b></span>
        </div>
      </div>
      <div class="qa" aria-label="Quick actions">
        <a href="/store/">🛍️ View store</a>
        <a href="#catalogue">🏷️ Products</a>
        <a href="#import">📥 Import CSV</a>
        <button type="button" class="off" disabled title="New products are added only with the owner's approval (weekly refresh)">＋ Add product</button>
      </div>

      <section class="glass notice" role="note">
        <strong>📊 IRFAN-GD is an AliExpress affiliate showcase.</strong>
        <p>This dashboard shows only: affiliate clicks (from GA4), top-performing products, and earnings <em>imported by the owner from official AliExpress Portals reports</em>. IRFAN-GD never collects payments and never sees customer payment data. Panels show <span class="unavail">NOT CONNECTED</span> until the D1 database is connected — no figure on this page is estimated or fabricated. <strong>Access mode (owner decision, 2026-11-11): viewing is currently open without a login</strong> — the owner chose to run the dashboard without the Cloudflare Access lock for now. Actions that change data (CSV import, manual sync) stay <strong>disabled</strong> until the owner configures the Access lock; configuring it later re-secures this page automatically. This page is not linked from the public site and carries <code>noindex</code>.</p>
      </section>

      <div class="grid2">
        <section class="glass card" aria-label="Clicks chart">
          <h2><i>📊</i> Clicks — Last 30 Days</h2>
          <div id="bars" class="bars" role="img" aria-label="Daily affiliate clicks, bar chart"></div>
          <p class="chart-note" id="barsNote">Bars fill in after the first GA4 sync.</p>
        </section>
        <section class="glass card" aria-label="Click share">
          <h2><i>🎯</i> Click Share by Product</h2>
          <div class="donut-wrap">
            <svg width="150" height="150" viewBox="0 0 120 120" role="img" aria-label="Donut chart of click share by product">
              <circle cx="60" cy="60" r="46" fill="none" stroke="rgba(122,90,40,.15)" stroke-width="16"></circle>
              <g id="donutSegs"></g>
              <text id="donutTotal" x="60" y="58" text-anchor="middle" font-size="17" font-weight="800" fill="#2a2013">0</text>
              <text x="60" y="76" text-anchor="middle" font-size="8.5" fill="#8a7a63">CLICKS · 30D</text>
            </svg>
            <ul id="donutLegend" class="legend"></ul>
          </div>
          <p class="chart-note" id="donutNote">Share appears after the first GA4 sync.</p>
        </section>
      </div>

      <section class="stats" aria-label="Key figures">
        <div class="glass stat" style="--acc:#4f8cff">
          <div class="lbl">Affiliate clicks · 7 days <i>🖱️</i></div>
          <div class="val mono" id="clicks7">—</div>
          <div class="hint">From GA4, synced daily</div>
        </div>
        <div class="glass stat" style="--acc:#38e1ff">
          <div class="lbl">Affiliate clicks · 30 days <i>📈</i></div>
          <div class="val mono" id="clicks30">—</div>
          <div class="hint">Rolling 30-day total</div>
        </div>
        <div class="glass stat" style="--acc:#8b5cf6">
          <div class="lbl">Products live <i>🛍️</i></div>
          <div class="val">{vis.length}</div>
          <div class="hint">{hidden.length} hidden — records kept</div>
        </div>
        <div class="glass stat" style="--acc:#34d399">
          <div class="lbl">Imported earnings <i>💰</i></div>
          <div class="val mono" id="earnTotal">—</div>
          <div class="hint"><span id="earnRows">0</span> report rows · last import: <span id="earnLast">never</span></div>
        </div>
      </section>

      <section class="glass card" style="margin-bottom:1.1rem" aria-label="Progress rings">
        <h2><i>🎯</i> Progress Rings</h2>
        <div class="gauges">
          <div class="gauge">
            <svg width="104" height="104" viewBox="0 0 104 104" role="img" aria-label="Imported earnings progress ring">
              <circle cx="52" cy="52" r="42" fill="none" stroke="rgba(122,90,40,.15)" stroke-width="10"></circle>
              <circle id="ringEarn" cx="52" cy="52" r="42" fill="none" stroke="#1d9e75" stroke-width="10" stroke-linecap="round" pathLength="100" stroke-dasharray="0 100" transform="rotate(-90 52 52)"></circle>
              <text id="ringEarnPct" x="52" y="58" text-anchor="middle" font-size="16" font-weight="800" fill="#2a2013">0%</text>
            </svg>
            <div class="gv" id="earnGoalVal">$0.00</div>
            <div class="gl">of first $100 earnings</div>
          </div>
          <div class="gauge">
            <svg width="104" height="104" viewBox="0 0 104 104" role="img" aria-label="Clicks progress ring">
              <circle cx="52" cy="52" r="42" fill="none" stroke="rgba(122,90,40,.15)" stroke-width="10"></circle>
              <circle id="ringClicks" cx="52" cy="52" r="42" fill="none" stroke="#bd8524" stroke-width="10" stroke-linecap="round" pathLength="100" stroke-dasharray="0 100" transform="rotate(-90 52 52)"></circle>
              <text id="ringClicksPct" x="52" y="58" text-anchor="middle" font-size="16" font-weight="800" fill="#2a2013">0%</text>
            </svg>
            <div class="gv" id="clicksGoalVal">0</div>
            <div class="gl">of 1,000 clicks · 30 days</div>
          </div>
          <div class="gauge">
            <svg width="104" height="104" viewBox="0 0 104 104" role="img" aria-label="Catalogue live share ring">
              <circle cx="52" cy="52" r="42" fill="none" stroke="rgba(122,90,40,.15)" stroke-width="10"></circle>
              <circle cx="52" cy="52" r="42" fill="none" stroke="#8b5cf6" stroke-width="10" stroke-linecap="round" pathLength="100" stroke-dasharray={`${Math.round(vis.length / (vis.length + hidden.length) * 100)} 100`} transform="rotate(-90 52 52)"></circle>
              <text x="52" y="58" text-anchor="middle" font-size="16" font-weight="800" fill="#2a2013">{Math.round(vis.length / (vis.length + hidden.length) * 100)}%</text>
            </svg>
            <div class="gv">{vis.length} of {vis.length + hidden.length}</div>
            <div class="gl">products live in catalogue</div>
          </div>
        </div>
        <p class="chart-note">Starter goals only — rings fill from the real figures above; nothing here is a projection.</p>
      </section>

      <div class="grid2">
        <section class="glass card" aria-label="Top products">
          <h2><i>🏆</i> Top-Performing Products</h2>
          <table id="topTable"><tr><th>Product</th><th>Clicks (30d)</th></tr><tr><td colspan="2"><span class="unavail">NOT CONNECTED</span> — figures appear after the first GA4 sync.</td></tr></table>
          <p style="margin-top:.9rem"><button type="button" id="syncBtn">Sync GA4 now</button> <span id="syncMsg" role="status"></span></p>
        </section>

        <section class="glass card" id="import" aria-label="Earnings imports">
          <h2><i>📥</i> Earnings — Portals CSV Import</h2>
          <form id="importForm">
            <label style="display:block;font-weight:700;color:#3a2f21;font-size:.92rem">Import a Portals CSV report (max 2 MB — enabled once the Access lock is configured)
              <input type="file" id="csvFile" name="file" accept=".csv,text/csv" required style="display:block;margin-top:.5rem" />
            </label>
            <p style="margin:.6rem 0"><button type="submit" id="importBtn">Import CSV</button> <span id="importMsg" role="status"></span></p>
            <p>Validation: file type and size checked server-side; the file's SHA-256 hash is recorded, so the same file can never be imported twice; each row is checked (date, product, amount) and duplicate rows are skipped and counted; a malformed file is rejected completely — nothing is partially imported. Imported rows are stored in the D1 database. While the dashboard runs without the Access lock, importing stays disabled so nobody can alter the figures.</p>
          </form>
        </section>
      </div>

      <section class="glass card" id="catalogue" style="margin-bottom:1.1rem" aria-label="Product catalogue">
        <h2><i>🗂️</i> Product Catalogue (current storefront data)</h2>
        <table>
          <tr><th>Product</th><th>Price (USD)</th><th>Rating</th><th>Sold</th><th>Status</th></tr>
          {(store.products as any[]).map(p => (
            <tr><td>{p.name}</td><td>${p.price.toFixed(2)}</td><td>★ {p.rating}</td><td>{p.sold || '—'}</td><td>{p.visible ? 'Live' : 'Hidden'}</td></tr>
          ))}
        </table>
      </section>

      <section class="glass card" aria-label="Admin activity">
        <h2><i>🧾</i> Admin Activity Log</h2>
        <table id="logTable"><tr><th>Time (UTC)</th><th>Actor</th><th>Action</th><th>Detail</th><th>Result</th></tr><tr><td colspan="5"><span class="unavail">NOT CONNECTED</span></td></tr></table>
        <p>Once the Access lock is configured, login sessions and every dashboard action are recorded here from the D1 database (Cloudflare's own Access log, in the Zero Trust dashboard, keeps only 24 hours on the free plan — this D1 log is the durable record). In the current no-lock mode, no sessions are recorded.</p>
      </section>
    </main>
  </div>

  <script is:inline>
    (function(){
      function el(id){ return document.getElementById(id); }
      function esc(s){ return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;'); }
      function notConnected(){
        el('whoami').textContent = 'Database not connected yet';
        el('clicks7').innerHTML = '<span class="unavail">NOT CONNECTED</span>';
        el('clicks30').innerHTML = '<span class="unavail">NOT CONNECTED</span>';
        el('earnTotal').innerHTML = '<span class="unavail">NOT CONNECTED</span>';
      }
      fetch('/api/admin/overview', { headers: { 'Accept': 'application/json' } }).then(function(r){
        if (!r.ok) throw new Error('http ' + r.status);
        return r.json();
      }).then(function(d){
        if (!d || !d.connected) { notConnected(); return; }
        el('whoami').textContent = d.email || 'owner';
        el('lastSync').textContent = d.lastSync || 'never';
        el('clicks7').textContent = d.clicks7d;
        el('clicks30').textContent = d.clicks30d;
        if (d.topProducts && d.topProducts.length) {
          el('topTable').innerHTML = '<tr><th>Product</th><th>Clicks (30d)</th></tr>' + d.topProducts.map(function(t){ return '<tr><td>' + esc(t.product) + '</td><td class="mono">' + esc(t.clicks) + '</td></tr>'; }).join('');
        } else {
          el('topTable').innerHTML = '<tr><th>Product</th><th>Clicks (30d)</th></tr><tr><td colspan="2">No clicks recorded yet.</td></tr>';
        }
        if (d.earnings) {
          el('earnTotal').textContent = '$' + (+d.earnings.total).toFixed(2);
          el('earnRows').textContent = d.earnings.rows;
          el('earnLast').textContent = d.earnings.lastImport || 'never';
          var earnPct = Math.max(0, Math.min(100, (+d.earnings.total) / 100 * 100));
          el('ringEarn').setAttribute('stroke-dasharray', earnPct + ' 100');
          el('ringEarnPct').textContent = Math.round(earnPct) + '%';
          el('earnGoalVal').textContent = '$' + (+d.earnings.total).toFixed(2);
        }
        var clicksPct = Math.max(0, Math.min(100, (d.clicks30d || 0) / 1000 * 100));
        el('ringClicks').setAttribute('stroke-dasharray', clicksPct + ' 100');
        el('ringClicksPct').textContent = Math.round(clicksPct) + '%';
        el('clicksGoalVal').textContent = d.clicks30d || 0;
        (function(){
          var byDate = {};
          (d.dailySeries || []).forEach(function(r){ byDate[r.date] = +r.clicks || 0; });
          var days = [], max = 0, total30 = 0;
          for (var i = 29; i >= 0; i--) {
            var dt = new Date(Date.now() - i * 86400000);
            var key = dt.toISOString().slice(0, 10);
            var v = byDate[key] || 0;
            days.push({ key: key, v: v });
            if (v > max) max = v;
            total30 += v;
          }
          el('bars').innerHTML = days.map(function(x){
            var h = x.v > 0 ? Math.max(6, Math.round(x.v / (max || 1) * 100)) : 3;
            return '<div class="bar' + (x.v > 0 ? '' : ' zero') + '" style="height:' + h + '%" title="' + x.key + ' — ' + x.v + ' clicks"></div>';
          }).join('');
          el('barsNote').textContent = total30 > 0 ? 'Total: ' + total30 + ' clicks in the last 30 days (hover a bar for its day).' : 'No clicks in the last 30 days yet — bars fill in after the first GA4 sync.';
        })();
        (function(){
          var tops = d.topProducts || [];
          var total = tops.reduce(function(a, t){ return a + (+t.clicks || 0); }, 0);
          var palette = ['#d9a441', '#4f8cff', '#38b2ac', '#8b5cf6', '#e2603f', '#7fb069', '#c65b8f', '#5b8e7d', '#b97f16', '#64748b'];
          if (total > 0) {
            var off = 25, segs = '', legend = '';
            tops.forEach(function(t, idx){
              var share = (+t.clicks || 0) / total * 100;
              segs += '<circle cx="60" cy="60" r="46" fill="none" stroke="' + palette[idx % palette.length] + '" stroke-width="16" pathLength="100" stroke-dasharray="' + share.toFixed(2) + ' ' + (100 - share).toFixed(2) + '" stroke-dashoffset="' + off + '"></circle>';
              off -= share;
              legend += '<li><span class="sw" style="background:' + palette[idx % palette.length] + '"></span>' + esc(t.product) + ' — ' + Math.round(share) + '%</li>';
            });
            el('donutSegs').innerHTML = segs;
            el('donutLegend').innerHTML = legend;
            el('donutTotal').textContent = total;
            el('donutNote').textContent = 'Share of clicks across the top products above (30 days).';
          }
        })();
        if (d.log && d.log.length) {
          el('logTable').innerHTML = '<tr><th>Time (UTC)</th><th>Actor</th><th>Action</th><th>Detail</th><th>Result</th></tr>' + d.log.map(function(l){ return '<tr><td class="mono">' + esc(l.ts) + '</td><td>' + esc(l.actor) + '</td><td>' + esc(l.action) + '</td><td>' + esc(l.detail) + '</td><td>' + esc(l.result) + '</td></tr>'; }).join('');
        } else {
          el('logTable').innerHTML = '<tr><th>Time (UTC)</th><th>Actor</th><th>Action</th><th>Detail</th><th>Result</th></tr><tr><td colspan="5">No activity recorded yet.</td></tr>';
        }
      }).catch(function(){ notConnected(); });

      el('syncBtn').addEventListener('click', function(){
        var btn = el('syncBtn'), msg = el('syncMsg');
        btn.disabled = true; msg.textContent = 'Syncing…'; msg.className = '';
        fetch('/api/admin/sync', { method: 'POST', headers: { 'Accept': 'application/json' } }).then(function(r){ return r.json().then(function(j){ return { ok: r.ok, j: j }; }); }).then(function(res){
          if (res.ok && res.j && res.j.ok) { msg.textContent = '✓ Synced at ' + (res.j.syncedAt || ''); msg.className = 'ok'; setTimeout(function(){ location.reload(); }, 900); }
          else { msg.textContent = '✗ ' + ((res.j && res.j.error) || 'Sync unavailable until backend is connected.'); msg.className = 'err'; }
        }).catch(function(){ msg.textContent = '✗ Sync unavailable until backend is connected.'; msg.className = 'err'; }).finally(function(){ btn.disabled = false; });
      });

      el('importForm').addEventListener('submit', function(ev){
        ev.preventDefault();
        var btn = el('importBtn'), msg = el('importMsg'), f = el('csvFile').files[0];
        if (!f) return;
        if (f.size > 2 * 1024 * 1024) { msg.textContent = '✗ File is larger than 2 MB.'; msg.className = 'err'; return; }
        if (!/\.csv$/i.test(f.name)) { msg.textContent = '✗ Only .csv files are accepted.'; msg.className = 'err'; return; }
        btn.disabled = true; msg.textContent = 'Validating & importing…'; msg.className = '';
        var fd = new FormData(); fd.append('file', f);
        fetch('/api/admin/import', { method: 'POST', body: fd, headers: { 'Accept': 'application/json' } }).then(function(r){ return r.json().then(function(j){ return { ok: r.ok, j: j }; }); }).then(function(res){
          if (res.ok && res.j && res.j.ok) { msg.textContent = '✓ Imported ' + res.j.imported + ' rows (' + res.j.skippedDuplicates + ' duplicates skipped).'; msg.className = 'ok'; setTimeout(function(){ location.reload(); }, 1200); }
          else { msg.textContent = '✗ ' + ((res.j && res.j.error) || 'Import unavailable until backend is connected.'); msg.className = 'err'; }
        }).catch(function(){ msg.textContent = '✗ Import unavailable until backend is connected.'; msg.className = 'err'; }).finally(function(){ btn.disabled = false; });
      });
    })();
  </script>
</body>
</html>
