---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { BlogExplorer } from '../../components/Explorers';
import BannerAd from '../../components/BannerAd.astro';
import { getPublishedPosts, fmtDate, readingTime, slugify, entrySlug } from '../../lib/content';
const posts = await getPublishedPosts();
const PER = 4;
const pagePosts = posts.slice(0, PER);
const totalPages = Math.ceil(posts.length / PER);
const cats = [...new Set(posts.map(p => p.data.category))];
const tags = [...new Set(posts.flatMap(p => p.data.tags))];
const explorerItems = posts.map(p => ({ title: p.data.title, description: p.data.description, url: `/blog/${entrySlug(p)}/`, category: p.data.category, tags: p.data.tags, date: fmtDate(p.data.pubDate), gradient: p.data.gradient, emoji: p.data.emoji, meta: `${fmtDate(p.data.pubDate)} · ${readingTime(p.body)} min read` }));
---
<BaseLayout title="Blog — NEXA" description="All NEXA articles: AI tools, technology, gaming, online business and creator guides. Search and filter by category.">
  <div class="mx-auto" style="max-width:1200px;padding:2.5rem 1rem 0">
    <h1 class="font-display" style="font-size:2.6rem;font-weight:900">The NEXA Blog</h1>
    <p class="text-dim" style="margin:.5rem 0 1rem">Search and filter every article. Drafts and future-dated (scheduled) posts are hidden until their publish date.</p>
    <nav aria-label="Categories" style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px">
      {cats.map(c => <a class="chip magnetic" style="min-height:40px;display:inline-flex;align-items:center" href={`/blog/category/${slugify(c)}/`}>{c}</a>)}
    </nav>
    <nav aria-label="Tags" style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:20px">
      {tags.map(t => <a class="chip" style="min-height:36px;display:inline-flex;align-items:center" href={`/blog/tag/${slugify(t)}/`}>#{t}</a>)}
    </nav>
    <BlogExplorer client:load items={explorerItems} />
    <BannerAd pageType="article" />
    <section aria-label="All articles, paginated" style="margin-top:2.5rem">
      <h2 style="font-weight:800;font-size:1.4rem">Browse page by page</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:1rem;margin-top:1rem">
        {pagePosts.map(p => <ArticleCard post={p} />)}
      </div>
      <nav aria-label="Pagination" style="display:flex;gap:8px;justify-content:center;margin-top:1.6rem;align-items:center">
        <span class="chip" aria-current="page">Page 1 of {totalPages}</span>
        {totalPages > 1 && <a class="btn btn-ghost magnetic" href="/blog/page/2/">Next →</a>}
      </nav>
    </section>
  </div>
</BaseLayout>
