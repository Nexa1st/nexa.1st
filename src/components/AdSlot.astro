---
/** Ad slot — renders at most ONE network per position (config conflict rule).
 *  Disabled / network 'none' / empty code -> NOTHING in production.
 *  Dev + showDevOutlines -> small labelled outline (flag defaults off). */
import { adsConfig, adSlotActive, resolveAdCode, type AdPlacement, type AdPageType } from '../config/ads';
interface Props { placement?: AdPlacement; pageType?: AdPageType; variant?: string }
const { placement = 'inArticle', pageType = 'article', variant = 'responsive' } = Astro.props as Props;
const { network, code } = resolveAdCode(placement);
const active = adSlotActive(placement, pageType);
const devOutline = import.meta.env.DEV && adsConfig.showDevOutlines;
---
<!-- Ad slot: renders nothing while ads are disabled in src/config/ads.ts (placement/page/variant come from props). -->
{active ? (
  <div class="ad-container" data-ad-placement={placement} data-ad-page={pageType} data-ad-network={network} role="complementary" aria-label="Advertisement">
    <p class="ad-label">Advertisement</p>
    <Fragment set:html={code} />
  </div>
) : devOutline ? (
  <div class="ad-dev-outline" aria-hidden="true">Advertisement — slot reserved ({placement} / {variant}) · ads disabled</div>
) : (
  <Fragment />
)}
<style>
  .ad-container{max-width:100%;overflow:hidden;margin:1.25rem auto;text-align:center}
  .ad-container[data-ad-placement="bannerDesktop"]{min-height:90px;aspect-ratio:728/90}
  .ad-container[data-ad-placement="bannerMobile"]{min-height:60px;aspect-ratio:320/60}
  .ad-container[data-ad-placement="sidebar"]{min-height:250px;aspect-ratio:300/250}
  .ad-container[data-ad-placement="inArticle"]{min-height:120px}
  .ad-container[data-ad-placement="native"],.ad-container[data-ad-placement="nativeBanner"]{min-height:160px}
  .ad-container[data-ad-placement="responsive"]{min-height:100px}
  .ad-container :global(img),.ad-container :global(iframe){max-width:100%!important;height:auto}
  .ad-label{font-size:.65rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:4px}
  .ad-dev-outline{border:1px dashed var(--stroke);border-radius:12px;padding:.6rem;text-align:center;font-size:.75rem;color:var(--ink-faint);margin:1rem auto;max-width:100%}
</style>
