---
import AdSlot from './AdSlot.astro';
import type { AdPageType } from '../config/ads';
interface Props { pageType?: AdPageType }
const { pageType = 'home' } = Astro.props as Props;
---
<span class="hidden md:block"><AdSlot placement="bannerDesktop" pageType={pageType} variant="banner-desktop" /></span>
<span class="md:hidden"><AdSlot placement="bannerMobile" pageType={pageType} variant="banner-mobile" /></span>
