# NEXA environment variables — copy to `.env` and fill ONLY after the
# corresponding free account/property exists. `.env` is gitignored.
# Leave empty to keep the feature completely off (nothing is emitted).

# Google Analytics 4 — this website needs its OWN GA4 property.
# Do NOT reuse a measurement ID from another NEXA property/page.
PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — HTML tag verification code (content value only).
PUBLIC_GSC_VERIFICATION=
